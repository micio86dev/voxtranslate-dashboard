# Production build values, loaded by `astro build`. Committed on purpose: these
# are PUBLIC_ (client-side) values that Astro bakes into the shipped JS anyway, so
# they are not secrets. Keeping them here makes every build (local or on the host)
# produce the right API base + Google client id without relying on provider env.
PUBLIC_API_BASE=https://api.voxtranslate.app
PUBLIC_GOOGLE_CLIENT_ID=1063340685131-sd0l2su8jilj9lm3724grj57bodi9e41.apps.googleusercontent.com
