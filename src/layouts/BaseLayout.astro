---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import { type Locale } from '../lib/i18n';

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  /** Render the app navigation shell (auth-gated pages). */
  chrome?: boolean;
}

const { lang, title, description = '', chrome = false } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Authenticated B2B app — keep it out of search indexes. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1220" media="(prefers-color-scheme: dark)" />
    {/* No-FOUC theme: explicit choice wins, else follow the OS (system default). */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('vox-theme');
          var dark = t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    {chrome && <Header lang={lang} />}
    <main class={chrome ? 'mx-auto w-full max-w-5xl px-4 py-8' : ''}>
      <slot />
    </main>
  </body>
</html>
