---
import { useTranslations, localizePath, type Locale } from '../../lib/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const link = (p: string) => localizePath(lang, p);
// Consumer call app (separate origin).
const APP_URL = 'https://voxtranslate.app';
---

<header class="border-b border-line bg-surface">
  <div class="mx-auto flex w-full max-w-5xl flex-wrap items-center gap-3 px-4 py-3">
    <a href={link('dashboard')} class="flex items-center gap-2 text-lg font-bold text-brand">
      <img src="/favicon-32.png" alt="" width="28" height="28" class="rounded-md" />
      VoxTranslate
    </a>
    <nav class="flex gap-1 text-sm">
      <a href={link('dashboard')} class="rounded px-3 py-1.5 hover:bg-base">{t('nav.dashboard')}</a>
      <a href={link('analytics')} class="rounded px-3 py-1.5 hover:bg-base">{t('nav.analytics')}</a>
      <a href={link('members')} class="rounded px-3 py-1.5 hover:bg-base">{t('nav.members')}</a>
      <a href={link('teams')} class="rounded px-3 py-1.5 hover:bg-base">{t('nav.teams')}</a>
      <a href={link('projects')} class="rounded px-3 py-1.5 hover:bg-base">{t('nav.projects')}</a>
      <a href={link('history')} class="rounded px-3 py-1.5 hover:bg-base">{t('nav.history')}</a>
      <a href={link('credits')} class="rounded px-3 py-1.5 hover:bg-base">{t('nav.credits')}</a>
      <a href={link('settings')} class="rounded px-3 py-1.5 hover:bg-base">{t('nav.settings')}</a>
    </nav>
    <div class="ml-auto flex items-center gap-2">
      <select id="org-switcher" class="field max-w-44 text-sm" aria-label={t('org.switch')} hidden
      ></select>
      <button
        id="theme-toggle"
        type="button"
        class="theme-toggle btn-ghost px-2.5"
        aria-label={t('theme.toDark')}
        data-label-light={t('theme.toLight')}
        data-label-dark={t('theme.toDark')}
      >
        <svg
          class="icon-moon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg
        >
        <svg
          class="icon-sun"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
          ></path></svg
        >
      </button>
      <a href={APP_URL} class="btn-ghost text-sm" target="_blank" rel="noopener">
        {t('common.openApp')}
      </a>
      <button id="signout" class="btn-ghost text-sm">{t('common.signOut')}</button>
    </div>
  </div>
</header>

<script>
  // Theme toggle: explicit choice persists; otherwise the OS preference is followed
  // live (system default). The pre-paint class is set in BaseLayout (no FOUC).
  (function () {
    const root = document.documentElement;
    const btn = document.getElementById('theme-toggle');
    const sync = () => {
      if (!btn) return;
      const isDark = root.classList.contains('dark');
      const lbl = isDark ? btn.dataset.labelLight : btn.dataset.labelDark;
      if (lbl) btn.setAttribute('aria-label', lbl);
    };
    btn?.addEventListener('click', () => {
      const isDark = root.classList.toggle('dark');
      try {
        localStorage.setItem('vox-theme', isDark ? 'dark' : 'light');
      } catch {
        /* private mode */
      }
      sync();
    });
    try {
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        if (localStorage.getItem('vox-theme')) return; // explicit choice wins
        root.classList.toggle('dark', e.matches);
        sync();
      });
    } catch {
      /* ignore */
    }
    sync();
  })();
</script>
