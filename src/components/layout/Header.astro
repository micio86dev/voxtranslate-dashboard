---
import { useTranslations, localizePath, type Locale } from '../../lib/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const link = (p: string) => localizePath(lang, p);
// Consumer call app (separate origin).
const APP_URL = 'https://voxtranslate.app';
---

<header class="border-b border-line bg-surface">
  <div class="mx-auto flex w-full max-w-5xl flex-wrap items-center gap-3 px-4 py-3">
    <a href={link('dashboard')} class="flex items-center gap-2 text-lg font-bold text-brand">
      <img src="/favicon-32.png" alt="" width="28" height="28" class="rounded-md" />
      VoxTranslate
    </a>
    <nav
      class="order-last flex w-full gap-1 overflow-x-auto whitespace-nowrap text-sm md:order-none md:w-auto"
    >
      <a href={link('dashboard')} class="rounded px-3 py-1.5 hover:bg-base">{t('nav.dashboard')}</a>
      <a href={link('meetings')} class="rounded px-3 py-1.5 hover:bg-base">{t('nav.meetings')}</a>
      <a href={link('analytics')} class="rounded px-3 py-1.5 hover:bg-base">{t('nav.analytics')}</a>
      <a href={link('members')} class="rounded px-3 py-1.5 hover:bg-base">{t('nav.members')}</a>
      <a href={link('teams')} class="rounded px-3 py-1.5 hover:bg-base">{t('nav.teams')}</a>
      <a href={link('projects')} class="rounded px-3 py-1.5 hover:bg-base">{t('nav.projects')}</a>
      <a href={link('history')} class="rounded px-3 py-1.5 hover:bg-base">{t('nav.history')}</a>
      <a href={link('search')} class="rounded px-3 py-1.5 hover:bg-base">{t('nav.search')}</a>
      <a href={link('insights')} class="rounded px-3 py-1.5 hover:bg-base">{t('nav.insights')}</a>
      <a href={link('activity')} class="rounded px-3 py-1.5 hover:bg-base">{t('nav.activity')}</a>
      <a href={link('credits')} class="rounded px-3 py-1.5 hover:bg-base">{t('nav.credits')}</a>
      <a href={link('settings')} class="rounded px-3 py-1.5 hover:bg-base">{t('nav.settings')}</a>
    </nav>
    <div class="ml-auto flex items-center gap-2">
      <select id="org-switcher" class="field max-w-44 text-sm" aria-label={t('org.switch')} hidden
      ></select>
      <!-- Notification bell + center -->
      <div class="relative">
        <button
          id="notif-btn"
          type="button"
          class="btn-ghost relative px-2.5"
          aria-label={t('notif.title')}
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path
              d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg
          >
          <span
            id="notif-badge"
            class="absolute -right-0.5 -top-0.5 hidden min-w-4 rounded-full bg-danger px-1 text-center text-[10px] leading-4 text-white"
          ></span>
        </button>
        <div
          id="notif-panel"
          class="absolute right-0 z-50 mt-2 hidden w-80 rounded-lg border border-line bg-surface shadow-lg"
        >
          <div class="flex items-center justify-between border-b border-line px-3 py-2">
            <span class="text-sm font-semibold">{t('notif.title')}</span>
            <button id="notif-readall" class="text-xs text-brand">{t('notif.markAll')}</button>
          </div>
          <div
            id="notif-list"
            class="max-h-80 overflow-y-auto text-sm"
            data-empty={t('notif.empty')}
          >
          </div>
          <div class="flex items-center justify-between border-t border-line px-3 py-2">
            <button id="notif-enable" class="hidden text-xs text-brand">{t('notif.enable')}</button>
            <a href={link('notifications')} class="text-xs text-muted">{t('notif.settings')}</a>
          </div>
        </div>
      </div>
      <button
        id="theme-toggle"
        type="button"
        class="theme-toggle btn-ghost px-2.5"
        aria-label={t('theme.toDark')}
        data-label-light={t('theme.toLight')}
        data-label-dark={t('theme.toDark')}
      >
        <svg
          class="icon-moon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg
        >
        <svg
          class="icon-sun"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
          ></path></svg
        >
      </button>
      <a href={APP_URL} class="btn-ghost text-sm" target="_blank" rel="noopener">
        {t('common.openApp')}
      </a>
      <button id="signout" class="btn-ghost text-sm">{t('common.signOut')}</button>
    </div>
  </div>
</header>

<script>
  // Theme toggle: explicit choice persists; otherwise the OS preference is followed
  // live (system default). The pre-paint class is set in BaseLayout (no FOUC).
  (function () {
    const root = document.documentElement;
    const btn = document.getElementById('theme-toggle');
    const sync = () => {
      if (!btn) return;
      const isDark = root.classList.contains('dark');
      const lbl = isDark ? btn.dataset.labelLight : btn.dataset.labelDark;
      if (lbl) btn.setAttribute('aria-label', lbl);
    };
    btn?.addEventListener('click', () => {
      const isDark = root.classList.toggle('dark');
      try {
        localStorage.setItem('vox-theme', isDark ? 'dark' : 'light');
      } catch {
        /* private mode */
      }
      sync();
    });
    try {
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        if (localStorage.getItem('vox-theme')) return; // explicit choice wins
        root.classList.toggle('dark', e.matches);
        sync();
      });
    } catch {
      /* ignore */
    }
    sync();
  })();
</script>

<script>
  // Notification bell + center: polls the in-app feed, renders a dropdown, and wires
  // mark-read + push opt-in. Only meaningful on authenticated pages (the header is
  // chrome-only); without a session the API 401s and the bell simply stays empty.
  import {
    listNotifications,
    markNotificationRead,
    markAllNotificationsRead,
    type NotificationItem,
  } from '../../lib/api';
  import { enablePush, isPushSubscribed, pushSupported } from '../../lib/push';
  import { getToken } from '../../lib/auth';

  function esc(s: string): string {
    return s.replace(
      /[&<>"]/g,
      (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] || c,
    );
  }

  void (async () => {
    if (!getToken()) return;
    const btn = document.getElementById('notif-btn');
    const panel = document.getElementById('notif-panel');
    const badge = document.getElementById('notif-badge');
    const list = document.getElementById('notif-list');
    if (!btn || !panel || !badge || !list) return;

    async function refresh() {
      const res = await listNotifications({ limit: 20 });
      if (!res.ok || !res.data) return;
      const { notifications, unread } = res.data;
      badge!.textContent = unread > 99 ? '99+' : String(unread);
      badge!.classList.toggle('hidden', unread === 0);
      list!.innerHTML = notifications.length
        ? notifications
            .map((n: NotificationItem) => {
              const join = (n.data?.join_url as string) || '';
              const unreadCls = n.read_at ? '' : 'bg-base';
              return `<div data-id="${n.id}" class="notif-item border-b border-line px-3 py-2 last:border-0 ${unreadCls}">
                <div class="font-medium">${esc(n.title)}</div>
                <div class="text-muted">${esc(n.body)}</div>
                ${join ? `<a href="${esc(join)}" target="_blank" rel="noopener" class="text-xs text-brand">${esc(join)}</a>` : ''}
              </div>`;
            })
            .join('')
        : `<p class="px-3 py-6 text-center text-muted">${esc(list!.dataset.empty || 'No notifications')}</p>`;
      list!.querySelectorAll<HTMLElement>('.notif-item').forEach((el) =>
        el.addEventListener('click', async () => {
          const id = el.dataset.id;
          if (id) {
            await markNotificationRead(id);
            void refresh();
          }
        }),
      );
    }

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = panel.classList.toggle('hidden');
      if (!open) void refresh();
    });
    document.addEventListener('click', (e) => {
      if (!panel.contains(e.target as Node) && !btn.contains(e.target as Node)) {
        panel.classList.add('hidden');
      }
    });
    document.getElementById('notif-readall')?.addEventListener('click', async () => {
      await markAllNotificationsRead();
      void refresh();
    });

    // The "Enable push" CTA only makes sense when this browser can do push AND
    // isn't already subscribed — otherwise it wrongly nags a user who already
    // turned push on. Defaults to hidden in the markup; revealed only here.
    const enableBtn = document.getElementById('notif-enable');
    async function syncPushCta() {
      if (!enableBtn) return;
      const offer = pushSupported() && !(await isPushSubscribed());
      enableBtn.classList.toggle('hidden', !offer);
    }
    enableBtn?.addEventListener('click', async () => {
      await enablePush();
      void syncPushCta();
    });
    void syncPushCta();

    await refresh();
    // Light polling so the badge stays roughly current without a socket.
    window.setInterval(() => void refresh(), 60_000);
  })();
</script>
