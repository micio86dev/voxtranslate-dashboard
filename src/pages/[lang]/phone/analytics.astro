---
/**
 * `/[lang]/phone/analytics/` — what the telephone did and what it cost (spec 0117).
 *
 * A meeting costs translation minutes. A telephone call costs translation minutes plus a
 * carrier, and the carrier's share varies by where you called — which is the first number
 * a finance person asks for and the one nobody could previously produce without paging
 * through a call list twenty-five rows at a time.
 *
 * Admin-only, matching the credits page and the meeting analytics: spend is financial data.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionNav from '../../../components/phone/SectionNav.astro';
import { localePaths, isLocale, DEFAULT_LOCALE, useTranslations } from '../../../lib/i18n';

export function getStaticPaths() {
  return localePaths();
}

const lang = isLocale(Astro.params.lang) ? Astro.params.lang : DEFAULT_LOCALE;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('phone.analytics.title')} chrome>
  <h1 class="text-2xl font-bold">{t('phone.analytics.title')}</h1>

  <SectionNav lang={lang} current="analytics" />

  <div id="voip-off" class="card mt-6 hidden">
    <p class="text-sm">{t('phone.disabled')}</p>
  </div>
  <div id="not-admin" class="card mt-6 hidden">
    <p class="text-sm">{t('phone.analytics.adminOnly')}</p>
  </div>

  <div id="analytics-page" class="mt-6 hidden grid gap-6">
    <p class="text-sm text-muted">{t('phone.analytics.window')}</p>

    <div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-6">
      <div class="card">
        <p class="text-xs text-muted">{t('phone.analytics.calls')}</p><p
          id="k-calls"
          class="text-2xl font-bold"
        >
          —
        </p>
      </div>
      <div class="card">
        <p class="text-xs text-muted">{t('phone.analytics.inbound')}</p><p
          id="k-in"
          class="text-2xl font-bold"
        >
          —
        </p>
      </div>
      <div class="card">
        <p class="text-xs text-muted">{t('phone.analytics.outbound')}</p><p
          id="k-out"
          class="text-2xl font-bold"
        >
          —
        </p>
      </div>
      <div class="card">
        <p class="text-xs text-muted">{t('phone.analytics.missed')}</p><p
          id="k-missed"
          class="text-2xl font-bold"
        >
          —
        </p>
      </div>
      <div class="card">
        <p class="text-xs text-muted">{t('phone.analytics.minutes')}</p><p
          id="k-minutes"
          class="text-2xl font-bold"
        >
          —
        </p>
      </div>
      <div class="card">
        <p class="text-xs text-muted">{t('phone.analytics.spent')}</p><p
          id="k-spent"
          class="text-2xl font-bold"
        >
          —
        </p>
      </div>
    </div>

    <p id="no-data" class="hidden text-sm text-muted">{t('phone.analytics.noData')}</p>

    <section class="card">
      <h2 class="text-sm font-semibold">{t('phone.analytics.perDay')}</h2>
      <div id="per-day" class="mt-3"></div>
    </section>

    <div class="grid gap-6 lg:grid-cols-2">
      <section class="card">
        <h2 class="text-sm font-semibold">{t('phone.analytics.byCountry')}</h2>
        <div id="by-country" class="mt-3"></div>
      </section>
      <section class="card">
        <h2 class="text-sm font-semibold">{t('phone.analytics.byLanguage')}</h2>
        <div id="by-language" class="mt-3"></div>
      </section>
      <section class="card">
        <h2 class="text-sm font-semibold">{t('phone.analytics.byTier')}</h2>
        <div id="by-tier" class="mt-3"></div>
      </section>
      <section class="card">
        <h2 class="text-sm font-semibold">{t('phone.analytics.byProject')}</h2>
        <div id="by-project" class="mt-3"></div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { onPage } from '../../../scripts/nav';
  import { boot } from '../../../scripts/app-boot';
  import { currentOrgId, getVoipAnalytics, getVoipSettings } from '../../../lib/api';
  import { useTranslations, type Locale } from '../../../lib/i18n';
  import { barChart, hbars } from '../../../lib/charts';
  import { formatCredits } from '../../../scripts/phone-dialer';

  onPage('analytics-page', async () => {
    const ctx = await boot();
    if (!ctx) return;
    const t = useTranslations(ctx.lang as Locale);
    const org = ctx.activeOrg.id ?? currentOrgId();
    if (!org) return;

    const $ = (id: string) => document.getElementById(id);

    const settings = await getVoipSettings(org);
    if (!settings.ok || !settings.data?.enabled) {
      $('voip-off')?.classList.remove('hidden');
      return;
    }
    // Gated here too, so a member is told why rather than shown an empty page. The server
    // refuses regardless; this is courtesy, not security.
    if (ctx.activeOrg.role !== 'admin' && ctx.activeOrg.role !== 'owner') {
      $('not-admin')?.classList.remove('hidden');
      return;
    }
    $('analytics-page')?.classList.remove('hidden');

    const res = await getVoipAnalytics(org, 30);
    if (!res.ok || !res.data) return;
    const data = res.data;

    const set = (id: string, value: string) => {
      const el = $(id);
      if (el) el.textContent = value;
    };
    set('k-calls', String(data.totals.calls));
    set('k-in', String(data.totals.inbound));
    set('k-out', String(data.totals.outbound));
    set('k-missed', String(data.totals.missed));
    // Seconds on the wire, minutes on the screen: the reader's units belong here rather
    // than in the query.
    set('k-minutes', String(Math.round(data.totals.seconds / 60)));
    set('k-spent', `$${formatCredits(data.telephony_credits_spent)}`);

    $('no-data')?.classList.toggle('hidden', data.totals.calls > 0);

    const perDay = $('per-day');
    if (perDay) {
      // `barChart` speaks in days, calls and minutes — the shape the meetings chart
      // already uses. Minutes are not broken down per day by the endpoint, so the series
      // carries zero there rather than a number invented to fill the axis.
      perDay.innerHTML = barChart(
        data.calls_by_day.map((p) => ({ day: p.day, calls: p.calls, minutes: 0 })),
        t('phone.analytics.calls'),
      );
    }
    const fill = (id: string, buckets: { label: string; calls: number }[]) => {
      const el = $(id);
      if (el) el.innerHTML = hbars(buckets.map((b) => ({ label: b.label, value: b.calls })));
    };
    fill('by-country', data.by_country);
    fill('by-language', data.by_language);
    fill('by-tier', data.by_tier);
    fill('by-project', data.by_project);
  });
</script>
