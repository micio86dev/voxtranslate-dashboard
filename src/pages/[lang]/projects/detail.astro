---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  localePaths,
  isLocale,
  DEFAULT_LOCALE,
  useTranslations,
  localizePath,
} from '../../../lib/i18n';

export function getStaticPaths() {
  return localePaths();
}

const lang = isLocale(Astro.params.lang) ? Astro.params.lang : DEFAULT_LOCALE;
const t = useTranslations(lang);
const link = (p: string) => localizePath(lang, p);
---

<BaseLayout lang={lang} title={t('projects.detailTitle')} chrome>
  <a href={link('projects')} class="text-sm text-muted hover:text-ink">← {t('projects.title')}</a>
  <div class="mt-2 flex items-start justify-between gap-2">
    <h1 id="proj-name" class="text-2xl font-bold">{t('common.loading')}</h1>
    <button id="archive" class="btn-danger hidden text-sm">{t('projects.archive')}</button>
  </div>
  <p id="proj-desc" class="mt-1 text-muted"></p>
  <div id="proj-langs" class="mt-3 flex flex-wrap gap-1"></div>

  <!-- AI storyboard -->
  <div class="mt-8 flex flex-wrap items-center justify-between gap-2">
    <h2 class="text-lg font-semibold">{t('storyboard.title')}</h2>
    <div id="sb-actions" class="hidden gap-2">
      <button id="sb-download" class="btn-ghost hidden text-sm">{t('storyboard.download')}</button>
      <button id="sb-generate" class="btn-primary text-sm">{t('storyboard.generate')}</button>
    </div>
  </div>
  <p class="mt-1 text-sm text-muted">{t('storyboard.subtitle')}</p>

  <div id="sb-form" class="mt-3 hidden">
    <label class="text-sm text-muted" for="sb-target">{t('storyboard.targetLabel')}</label>
    <textarea
      id="sb-target"
      class="field mt-1 w-full text-sm"
      rows="3"
      maxlength="4000"
      placeholder={t('storyboard.targetPh')}></textarea>
    <div class="mt-2 flex gap-2">
      <button id="sb-run" class="btn-primary text-sm">{t('storyboard.run')}</button>
      <button id="sb-cancel" class="btn-ghost text-sm">{t('common.cancel')}</button>
    </div>
  </div>

  <p id="sb-msg" class="mt-3 text-sm text-muted"></p>

  <!-- View toggle: the same storyboard rendered as a Markdown document or as a
       vertical timeline of its sections. Shown only once a storyboard exists. -->
  <div
    id="sb-tabs"
    role="tablist"
    aria-label={t('storyboard.viewsLabel')}
    class="mt-3 hidden w-max items-center gap-0.5 rounded-lg border border-line bg-base p-0.5 text-sm"
  >
    <button
      id="sb-tab-doc"
      role="tab"
      aria-selected="true"
      aria-controls="sb-doc"
      class="rounded-md px-3 py-1.5 font-medium">{t('storyboard.viewDocument')}</button
    >
    <button
      id="sb-tab-timeline"
      role="tab"
      aria-selected="false"
      aria-controls="sb-timeline"
      tabindex="-1"
      class="rounded-md px-3 py-1.5 font-medium">{t('storyboard.viewTimeline')}</button
    >
  </div>

  <article id="sb-doc" role="tabpanel" aria-labelledby="sb-tab-doc" class="card mt-3 hidden">
  </article>
  <article
    id="sb-timeline"
    role="tabpanel"
    aria-labelledby="sb-tab-timeline"
    tabindex="0"
    class="card mt-3 hidden"
  >
  </article>

  <!-- Semantic search scoped to this project -->
  <h2 class="mt-8 text-lg font-semibold">{t('search.projectSearchTitle')}</h2>
  <p class="mt-1 text-sm text-muted">{t('search.projectSearchSubtitle')}</p>
  <form id="proj-search" class="mt-3 flex flex-wrap items-end gap-2">
    <input
      id="proj-search-q"
      type="search"
      class="field min-w-48 flex-1"
      placeholder={t('search.projectSearchPh')}
      autocomplete="off"
    />
    <button type="submit" class="btn-primary text-sm">{t('search.run')}</button>
  </form>

  <!-- Project voice notes: record a note onto the project (no call); it's
       transcribed + translated and feeds the project's insights. Shown only for
       orgs with an active subscription. -->
  <div id="vn-section" class="mt-8 hidden">
    <h2 class="text-lg font-semibold">{t('voiceNotes.title')}</h2>
    <p class="mt-1 text-sm text-muted">{t('voiceNotes.subtitle')}</p>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <button id="vn-record" class="btn-primary text-sm">{t('voiceNotes.record')}</button>
      <div id="vn-recording" class="hidden items-center gap-2">
        <span class="inline-block h-2.5 w-2.5 animate-pulse rounded-full bg-current text-danger"
        ></span>
        <span id="vn-time" class="text-sm tabular-nums">0:00</span>
        <button id="vn-cancel" class="btn-ghost text-sm">{t('common.cancel')}</button>
        <button id="vn-send" class="btn-primary text-sm">{t('voiceNotes.send')}</button>
      </div>
    </div>
    <p id="vn-msg" class="mt-2 text-sm text-muted"></p>
    <div id="vn-list" class="mt-3 flex flex-col gap-2"></div>
  </div>

  <h2 class="mt-8 text-lg font-semibold">{t('projects.callsInProject')}</h2>
  <p class="card mt-3 text-sm text-muted">—</p>
</BaseLayout>

<script>
  import { boot } from '../../../scripts/app-boot';
  import {
    deleteProject,
    generateStoryboard,
    getProject,
    getStoryboard,
    listVoiceMessages,
    uploadVoiceMessage,
    voiceMessageAudioUrl,
    type ProjectStoryboard,
    type ProjectVoiceMessage,
  } from '../../../lib/api';
  import { useTranslations, type Locale } from '../../../lib/i18n';

  function esc(s: string): string {
    return s.replace(
      /[&<>"]/g,
      (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] || c,
    );
  }

  /** Minimal, safe Markdown → HTML: escape first, then headings, bold, lists,
   *  and paragraphs. Enough for the AI storyboard; never injects raw HTML. */
  function renderMarkdown(md: string): string {
    const lines = esc(md).split('\n');
    let html = '';
    let inList = false;
    const closeList = () => {
      if (inList) {
        html += '</ul>';
        inList = false;
      }
    };
    for (const raw of lines) {
      const line = raw.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      if (/^#{1,2}\s+/.test(line)) {
        closeList();
        html += `<h3 class="mt-4 mb-1 font-semibold">${line.replace(/^#{1,2}\s+/, '')}</h3>`;
      } else if (/^#{3,}\s+/.test(line)) {
        closeList();
        html += `<h4 class="mt-3 mb-1 font-medium">${line.replace(/^#{3,}\s+/, '')}</h4>`;
      } else if (/^\s*[-*]\s+/.test(line)) {
        if (!inList) {
          html += '<ul class="ml-5 list-disc">';
          inList = true;
        }
        html += `<li>${line.replace(/^\s*[-*]\s+/, '')}</li>`;
      } else if (line.trim() === '') {
        closeList();
      } else {
        closeList();
        html += `<p class="mt-2">${line}</p>`;
      }
    }
    closeList();
    return html;
  }

  /** Split storyboard Markdown into its top-level (#/##) sections, one per
   *  timeline node. Text before the first heading becomes an untitled lead node. */
  function splitSections(md: string): { title: string; body: string }[] {
    const out: { title: string; body: string }[] = [];
    let cur: { title: string; body: string } | null = null;
    for (const line of md.split('\n')) {
      const m = /^#{1,2}\s+(.*\S)\s*$/.exec(line);
      if (m) {
        if (cur) out.push(cur);
        cur = { title: m[1], body: '' };
      } else if (cur) {
        cur.body += line + '\n';
      } else if (line.trim()) {
        cur = { title: '', body: line + '\n' };
      }
    }
    if (cur) out.push(cur);
    return out.filter((s) => s.title || s.body.trim());
  }

  /** Render the storyboard as a vertical timeline — one node per section on a
   *  brand-dotted rail. Bodies reuse renderMarkdown (minus the section heading).
   *  Falls back to the plain document if the text has no headings to anchor on. */
  function renderTimeline(md: string): string {
    const sections = splitSections(md);
    if (sections.length < 2) return renderMarkdown(md);
    const nodes = sections
      .map((s) => {
        const title = s.title
          ? `<h3 class="font-semibold leading-6 text-ink">${esc(s.title).replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')}</h3>`
          : '';
        const body = s.body.trim()
          ? `<div class="mt-1 text-sm text-muted [&_h3]:mt-3 [&_h3]:text-sm [&_h3]:text-ink [&_h4]:text-ink [&_strong]:text-ink">${renderMarkdown(s.body.trim())}</div>`
          : '';
        return `<li class="relative pl-9 pb-7 last:pb-0">
            <span class="absolute left-0 top-0.5 grid h-[22px] w-[22px] place-items-center rounded-full border-2 border-brand bg-surface" aria-hidden="true">
              <span class="h-1.5 w-1.5 rounded-full bg-brand"></span>
            </span>
            ${title}${body}
          </li>`;
      })
      .join('');
    return `<ol class="relative before:absolute before:bottom-2 before:left-[11px] before:top-2 before:w-px before:bg-line">${nodes}</ol>`;
  }

  void (async () => {
    const ctx = await boot();
    if (!ctx) return;
    const t = useTranslations(ctx.lang as Locale);
    const id = new URLSearchParams(location.search).get('id');
    if (!id) {
      location.href = `/${ctx.lang}/projects/`;
      return;
    }
    const res = await getProject(ctx.activeOrg.id, id);
    if (!res.ok || !res.data) {
      location.href = `/${ctx.lang}/projects/`;
      return;
    }
    const p = res.data;
    document.getElementById('proj-name')!.textContent = p.name;
    document.getElementById('proj-desc')!.textContent = p.description ?? '';
    document.getElementById('proj-langs')!.innerHTML = (p.default_languages ?? [])
      .map((l) => `<span class="badge">${esc(l)}</span>`)
      .join(' ');

    const archive = document.getElementById('archive') as HTMLButtonElement;
    archive.classList.remove('hidden');
    archive.addEventListener('click', async () => {
      if (!confirm(t('projects.archiveConfirm', { name: p.name }))) return;
      await deleteProject(ctx.activeOrg.id, p.id);
      location.href = `/${ctx.lang}/projects/`;
    });

    // Per-project semantic search: deep-link to the global Search page pre-scoped to
    // this project (?project=&q=), so the search logic lives in one place.
    const searchForm = document.getElementById('proj-search') as HTMLFormElement;
    const searchInput = document.getElementById('proj-search-q') as HTMLInputElement;
    searchForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = searchInput.value.trim();
      if (!q) return;
      const params = new URLSearchParams({ project: p.id, q });
      location.href = `/${ctx.lang}/search/?${params.toString()}`;
    });

    // --- AI storyboard ---
    const isAdmin = ctx.activeOrg.role === 'admin' || ctx.activeOrg.role === 'owner';
    const sbMsg = document.getElementById('sb-msg')!;
    const sbDoc = document.getElementById('sb-doc')!;
    const sbForm = document.getElementById('sb-form')!;
    const sbActions = document.getElementById('sb-actions')!;
    const sbGenerate = document.getElementById('sb-generate') as HTMLButtonElement;
    const sbDownload = document.getElementById('sb-download') as HTMLButtonElement;
    const sbTarget = document.getElementById('sb-target') as HTMLTextAreaElement;
    const sbTimeline = document.getElementById('sb-timeline')!;
    const sbTabs = document.getElementById('sb-tabs')!;
    const sbTabDoc = document.getElementById('sb-tab-doc') as HTMLButtonElement;
    const sbTabTimeline = document.getElementById('sb-tab-timeline') as HTMLButtonElement;
    let current: ProjectStoryboard | null = null;
    let sbView: 'doc' | 'timeline' = 'doc';

    if (isAdmin) sbActions.classList.replace('hidden', 'flex');

    // Document ⇄ Timeline toggle (WAI-ARIA tabs: aria-selected + roving tabindex).
    const sbTabClass = (active: boolean) =>
      `rounded-md px-3 py-1.5 font-medium transition-colors ${
        active ? 'bg-surface text-ink shadow-sm' : 'text-muted hover:text-ink'
      }`;
    const selectSbView = (view: 'doc' | 'timeline') => {
      sbView = view;
      const doc = view === 'doc';
      sbTabDoc.setAttribute('aria-selected', String(doc));
      sbTabTimeline.setAttribute('aria-selected', String(!doc));
      sbTabDoc.tabIndex = doc ? 0 : -1;
      sbTabTimeline.tabIndex = doc ? -1 : 0;
      sbTabDoc.className = sbTabClass(doc);
      sbTabTimeline.className = sbTabClass(!doc);
      sbDoc.classList.toggle('hidden', !doc);
      sbTimeline.classList.toggle('hidden', doc);
    };
    sbTabDoc.addEventListener('click', () => selectSbView('doc'));
    sbTabTimeline.addEventListener('click', () => selectSbView('timeline'));
    sbTabs.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      const next = sbView === 'doc' ? 'timeline' : 'doc';
      selectSbView(next);
      (next === 'doc' ? sbTabDoc : sbTabTimeline).focus();
    });

    const showStoryboard = (sb: ProjectStoryboard | null) => {
      current = sb;
      sbMsg.className = 'mt-3 text-sm text-muted';
      if (sb) {
        sbDoc.innerHTML = renderMarkdown(sb.markdown);
        sbTimeline.innerHTML = renderTimeline(sb.markdown);
        if (sbTabs.classList.contains('hidden')) sbTabs.classList.replace('hidden', 'inline-flex');
        selectSbView(sbView); // shows the active panel, hides the other
        sbDownload.classList.remove('hidden');
        sbMsg.textContent = t('storyboard.updated', {
          date: new Date(sb.updated_at).toLocaleString(ctx.lang),
        });
        sbGenerate.textContent = t('storyboard.regenerate');
        if (sb.target_workflow) sbTarget.value = sb.target_workflow;
      } else {
        sbDoc.classList.add('hidden');
        sbTimeline.classList.add('hidden');
        if (!sbTabs.classList.contains('hidden')) sbTabs.classList.replace('inline-flex', 'hidden');
        sbDownload.classList.add('hidden');
        sbMsg.textContent = t('storyboard.none');
        sbGenerate.textContent = t('storyboard.generate');
      }
    };

    const sbRes = await getStoryboard(ctx.activeOrg.id, p.id);
    showStoryboard(sbRes.ok ? sbRes.data : null);

    sbGenerate.addEventListener('click', () => sbForm.classList.toggle('hidden'));
    document
      .getElementById('sb-cancel')!
      .addEventListener('click', () => sbForm.classList.add('hidden'));

    document.getElementById('sb-run')!.addEventListener('click', async () => {
      sbForm.classList.add('hidden');
      sbMsg.textContent = t('storyboard.generating');
      sbMsg.className = 'mt-3 text-sm text-muted';
      sbGenerate.disabled = true;
      const r = await generateStoryboard(ctx.activeOrg.id, p.id, {
        target_workflow: sbTarget.value.trim() || undefined,
        lang: ctx.lang,
      });
      sbGenerate.disabled = false;
      if (r.ok && r.data) {
        showStoryboard(r.data);
      } else if (r.status === 402) {
        sbMsg.innerHTML = `${t('storyboard.noCredits')} <a href="/${ctx.lang}/credits/" class="font-medium text-brand underline">${t('credits.buy')}</a>`;
        sbMsg.className = 'mt-3 text-sm text-danger';
      } else {
        sbMsg.textContent = t('storyboard.error');
        sbMsg.className = 'mt-3 text-sm text-danger';
      }
    });

    sbDownload.addEventListener('click', () => {
      if (!current) return;
      const blob = new Blob([current.markdown], { type: 'text/markdown' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `storyboard-${p.name.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}.md`;
      a.click();
      URL.revokeObjectURL(url);
    });

    // --- Project voice notes (active-subscription orgs) ---
    if (ctx.activeOrg.subscription_status === 'active') {
      document.getElementById('vn-section')!.classList.remove('hidden');
      setupVoiceNotes(ctx.activeOrg.id, p.id, ctx.lang, t);
    }
  })();

  /** mm:ss for an elapsed millisecond count (negatives clamp to 0). */
  function recTime(ms: number): string {
    const s = Math.max(0, Math.floor(ms / 1000));
    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
  }

  /** Wire the record button + recording bar + notes list for a project. */
  function setupVoiceNotes(
    orgId: string,
    projectId: string,
    lang: string,
    t: (k: string, v?: Record<string, string | number>) => string,
  ): void {
    const recordBtn = document.getElementById('vn-record') as HTMLButtonElement;
    const bar = document.getElementById('vn-recording')!;
    const timeEl = document.getElementById('vn-time')!;
    const msg = document.getElementById('vn-msg')!;
    const listEl = document.getElementById('vn-list')!;
    const MAX_MS = 60_000;

    let recorder: MediaRecorder | null = null;
    let chunks: BlobPart[] = [];
    let stream: MediaStream | null = null;
    let timer: number | null = null;
    let startMs = 0;
    let shouldSend = false;
    let durationS = 0;

    const setBar = (recording: boolean) => {
      bar.classList.toggle('hidden', !recording);
      bar.classList.toggle('flex', recording);
      recordBtn.classList.toggle('hidden', recording);
    };

    async function loadNotes(): Promise<void> {
      const res = await listVoiceMessages(orgId, projectId);
      const notes = res.data?.voice_messages ?? [];
      renderNotes(notes);
    }

    function renderNotes(notes: ProjectVoiceMessage[]): void {
      listEl.innerHTML = '';
      if (!notes.length) {
        listEl.innerHTML = `<p class="card text-sm text-muted">${esc(t('voiceNotes.empty'))}</p>`;
        return;
      }
      for (const n of notes) {
        const card = document.createElement('div');
        card.className = 'card flex flex-col gap-1';
        const meta = `${esc(n.created_by_name)} · ${esc(n.source_language.toUpperCase())}${n.translated ? ' ✓' : ''}`;
        const when = new Date(n.created_at).toLocaleString(lang);
        card.innerHTML = `<div class="flex justify-between gap-2 text-xs text-muted"><span>${meta}</span><span>${esc(when)}</span></div>`;
        const play = document.createElement('button');
        play.className = 'btn-ghost self-start text-sm';
        play.textContent = `▶ ${recTime((n.duration_seconds ?? 0) * 1000)}`;
        play.addEventListener('click', async () => {
          play.disabled = true;
          const r = await voiceMessageAudioUrl(orgId, projectId, n.id);
          if (!r.ok || !r.data?.url) {
            play.disabled = false;
            return;
          }
          const audio = document.createElement('audio');
          audio.controls = true;
          audio.autoplay = true;
          audio.src = r.data.url;
          audio.className = 'mt-1 w-full max-w-sm';
          play.replaceWith(audio);
        });
        card.appendChild(play);
        listEl.appendChild(card);
      }
    }

    function finalize(): void {
      const captured = chunks;
      const type = recorder?.mimeType || 'audio/webm';
      recorder = null;
      chunks = [];
      if (stream) {
        stream.getTracks().forEach((tr) => tr.stop());
        stream = null;
      }
      setBar(false);
      if (!shouldSend || !captured.length) return;
      void send(new Blob(captured, { type }), durationS);
    }

    async function send(blob: Blob, seconds: number): Promise<void> {
      const ext = /mp4|m4a|aac/.test(blob.type) ? 'm4a' : /ogg/.test(blob.type) ? 'ogg' : 'webm';
      const file = new File([blob], `voice-message.${ext}`, { type: blob.type || `audio/${ext}` });
      recordBtn.disabled = true;
      msg.className = 'mt-2 text-sm text-muted';
      msg.textContent = t('voiceNotes.uploading');
      const res = await uploadVoiceMessage(orgId, projectId, file, seconds);
      recordBtn.disabled = false;
      if (!res.ok) {
        msg.className = 'mt-2 text-sm text-danger';
        msg.textContent = t('voiceNotes.error');
        return;
      }
      if (res.data?.translate_blocked === 'credits') {
        msg.className = 'mt-2 text-sm text-danger';
        msg.innerHTML = `${esc(t('voiceNotes.noCredits'))} <a href="/${lang}/credits/" class="font-medium text-brand underline">${esc(t('credits.buy'))}</a>`;
      } else {
        msg.className = 'mt-2 text-sm text-muted';
        msg.textContent = t('voiceNotes.sent');
      }
      await loadNotes();
    }

    function stop(doSend: boolean): void {
      if (!recorder) return;
      shouldSend = doSend;
      durationS = Math.round((Date.now() - startMs) / 1000);
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
      if (recorder.state !== 'inactive') recorder.stop();
    }

    recordBtn.addEventListener('click', async () => {
      if (recorder) return;
      try {
        stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      } catch {
        msg.className = 'mt-2 text-sm text-danger';
        msg.textContent = t('voiceNotes.micDenied');
        return;
      }
      const mime = ['audio/webm;codecs=opus', 'audio/webm', 'audio/mp4'].find((ty) =>
        MediaRecorder.isTypeSupported?.(ty),
      );
      chunks = [];
      shouldSend = false;
      try {
        recorder = new MediaRecorder(stream, mime ? { mimeType: mime } : undefined);
      } catch {
        stream.getTracks().forEach((tr) => tr.stop());
        stream = null;
        return;
      }
      recorder.ondataavailable = (e) => {
        if (e.data.size) chunks.push(e.data);
      };
      recorder.onstop = finalize;
      recorder.start();
      startMs = Date.now();
      msg.textContent = '';
      timeEl.textContent = '0:00';
      setBar(true);
      timer = window.setInterval(() => {
        const elapsed = Date.now() - startMs;
        timeEl.textContent = recTime(elapsed);
        if (elapsed >= MAX_MS) stop(true);
      }, 200);
    });
    document.getElementById('vn-send')!.addEventListener('click', () => stop(true));
    document.getElementById('vn-cancel')!.addEventListener('click', () => stop(false));

    void loadNotes();
  }
</script>
