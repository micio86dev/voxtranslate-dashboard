---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  localePaths,
  isLocale,
  DEFAULT_LOCALE,
  useTranslations,
  localizePath,
} from '../../../lib/i18n';

export function getStaticPaths() {
  return localePaths();
}

const lang = isLocale(Astro.params.lang) ? Astro.params.lang : DEFAULT_LOCALE;
const t = useTranslations(lang);
const link = (p: string) => localizePath(lang, p);
---

<BaseLayout lang={lang} title={t('projects.title')} chrome>
  <span id="page-projects" hidden></span>
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold">{t('projects.title')}</h1>
    <a href={link('projects/new')} class="btn-primary">{t('projects.new')}</a>
  </div>

  <div id="grid" class="mt-6 grid gap-4 sm:grid-cols-2"></div>
  <p id="empty" class="card mt-6 hidden text-center text-muted">{t('projects.empty')}</p>
</BaseLayout>

<script>
  import { onPage } from '../../../scripts/nav';
  import { boot } from '../../../scripts/app-boot';
  import { deleteProject, listProjects } from '../../../lib/api';
  import { useTranslations, type Locale } from '../../../lib/i18n';

  function esc(s: string): string {
    return s.replace(
      /[&<>"]/g,
      (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] || c,
    );
  }

  onPage('page-projects', async () => {
    const ctx = await boot();
    if (!ctx) return;
    const t = useTranslations(ctx.lang as Locale);
    const orgId = ctx.activeOrg.id;
    const grid = document.getElementById('grid')!;
    const empty = document.getElementById('empty')!;
    const detail = (id: string) => `/${ctx.lang}/projects/detail/?id=${encodeURIComponent(id)}`;

    async function render() {
      const res = await listProjects(orgId);
      const projects = res.data ?? [];
      empty.classList.toggle('hidden', projects.length > 0);
      grid.innerHTML = projects
        .map((p) => {
          const langs = (p.default_languages ?? [])
            .map((l) => `<span class="badge">${esc(l)}</span>`)
            .join(' ');
          return `<div class="card">
            <div class="flex items-start justify-between gap-2">
              <a href="${detail(p.id)}" class="text-lg font-semibold hover:text-brand">${esc(p.name)}</a>
              <button data-archive="${p.id}" data-name="${esc(p.name)}" class="btn-danger text-xs">${esc(t('projects.archive'))}</button>
            </div>
            ${p.description ? `<p class="mt-1 text-sm text-muted">${esc(p.description)}</p>` : ''}
            <div class="mt-3 flex flex-wrap gap-1">${langs}</div>
          </div>`;
        })
        .join('');
      grid.querySelectorAll<HTMLButtonElement>('[data-archive]').forEach((btn) =>
        btn.addEventListener('click', async () => {
          if (!confirm(t('projects.archiveConfirm', { name: btn.dataset.name ?? '' }))) return;
          await deleteProject(orgId, btn.dataset.archive!);
          void render();
        }),
      );
    }
    void render();
  });
</script>
