---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  localePaths,
  isLocale,
  DEFAULT_LOCALE,
  useTranslations,
  localizePath,
} from '../../../lib/i18n';

export function getStaticPaths() {
  return localePaths();
}

const lang = isLocale(Astro.params.lang) ? Astro.params.lang : DEFAULT_LOCALE;
const t = useTranslations(lang);
const link = (p: string) => localizePath(lang, p);
// Languages offered for on-demand translation (codes the backend/Groq accept).
const TRANSLATE_LANGS = ['it', 'en', 'es', 'de', 'fr', 'pt', 'ja', 'zh', 'ar', 'hi', 'ru'];
---

<BaseLayout lang={lang} title={t('transcript.title')} chrome>
  <a href={link('history')} class="text-sm text-muted hover:text-ink">← {t('history.title')}</a>
  <div class="mt-2 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold">{t('transcript.title')}</h1>
    <div id="tools" class="hidden flex-wrap items-center gap-2">
      <select id="lang-sel" class="field max-w-44 text-sm">
        <option value="">{t('transcript.original')}</option>
        {TRANSLATE_LANGS.map((l) => <option value={l}>{l}</option>)}
      </select>
      <button id="ex-txt" class="btn-ghost text-sm">{t('transcript.exportTxt')}</button>
      <button id="ex-pdf" class="btn-ghost text-sm">{t('transcript.exportPdf')}</button>
      <button id="rec-load" class="btn-ghost text-sm">{t('transcript.loadRecording')}</button>
    </div>
  </div>

  <p id="msg" class="mt-4 text-muted">{t('common.loading')}</p>
  <video
    id="player"
    class="mt-4 hidden max-h-[70vh] w-full rounded-lg bg-black"
    controls
    playsinline></video>
  <div id="body" class="mt-4 space-y-3"></div>

  <!-- AI summary (hotfix 0.16.1): reuses the webinars/detail.astro report pattern for
       every non-webinar session, phone calls included. -->
  <section id="report" class="card mt-6 hidden grid gap-2" aria-labelledby="report-h">
    <h2 id="report-h" class="text-sm font-semibold">{t('transcript.reportTitle')}</h2>
    <div id="report-body" class="text-sm"></div>
  </section>

  <!-- Sentiment (hotfix 0.16.1): text-only analysis of the transcript, never of audio. -->
  <section id="sentiment" class="card mt-6 hidden grid gap-3" aria-labelledby="sentiment-h">
    <h2 id="sentiment-h" class="text-sm font-semibold">{t('transcript.sentimentTitle')}</h2>
    <p class="text-xs text-muted">{t('transcript.sentimentTextOnly')}</p>
    <div id="sentiment-body" class="text-sm"></div>
  </section>
</BaseLayout>

<script>
  import { onPage } from '../../../scripts/nav';
  import { boot } from '../../../scripts/app-boot';
  import {
    downloadTranscript,
    getSessionReport,
    getSessionSentiment,
    getTranscript,
    recordingUrl,
    translateTranscript,
    type Segment,
  } from '../../../lib/api';
  import { useTranslations, type Locale } from '../../../lib/i18n';
  import {
    aiFeatureState,
    classifyAiFetch,
    formatSentimentScore,
    isReportRow,
    isSentimentRow,
    sentimentMoodKey,
    type AiFeatureState,
  } from '../../../scripts/call-ai';
  import { showsRoomRecording } from '../../../scripts/session-recording';

  // Coerces before escaping: some fields below come from a loosely-shape-checked array
  // (`isSentimentRow` only guarantees `speakers`/`key_moments` ARE arrays, not that every
  // entry inside them is well-formed), so a missing `name`/`label` must render as an
  // empty string rather than throw on `undefined.replace`.
  function esc(s: unknown): string {
    return String(s ?? '').replace(
      /[&<>"]/g,
      (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] || c,
    );
  }

  const REPORT_COPY: Record<Exclude<AiFeatureState, 'ready'>, string> = {
    pending: 'transcript.reportPending',
    notRequested: 'transcript.reportNotRequested',
    error: 'transcript.reportError',
    none: 'transcript.reportNone',
  };
  const SENTIMENT_COPY: Record<Exclude<AiFeatureState, 'ready'>, string> = {
    pending: 'transcript.sentimentPending',
    notRequested: 'transcript.sentimentNotRequested',
    error: 'transcript.sentimentError',
    none: 'transcript.sentimentNone',
  };

  /**
   * AI summary + sentiment (hotfix 0.16.1), reusing the webinars/detail.astro report
   * pattern for every non-webinar session — phone calls included. Runs independently of
   * the transcript render above it: a report/sentiment row can exist (or be pending)
   * whatever state the transcript body itself ends up in.
   *
   * Each fetch is classified on its own (`Promise.allSettled`, not `Promise.all`), so a
   * failure on one side never blanks the other, and the whole thing is wrapped so a
   * genuinely unexpected rejection renders an error state instead of leaving both
   * sections empty with an unhandled rejection in the console.
   */
  async function loadAiSections(
    sessionId: string,
    transcriptStatus: string | null | undefined,
    aiRequested: boolean | null | undefined,
    t: (key: string) => string,
  ) {
    const reportSection = document.getElementById('report');
    const reportBody = document.getElementById('report-body');
    const sentimentSection = document.getElementById('sentiment');
    const sentimentBody = document.getElementById('sentiment-body');
    if (!reportSection || !reportBody || !sentimentSection || !sentimentBody) return;

    try {
      const [reportSettled, sentimentSettled] = await Promise.allSettled([
        getSessionReport(sessionId),
        getSessionSentiment(sessionId),
      ]);

      reportSection.classList.remove('hidden');
      const reportOutcome = classifyAiFetch(reportSettled);
      const reportState = aiFeatureState(reportOutcome, isReportRow, transcriptStatus, aiRequested);
      if (reportState !== 'ready') {
        reportBody.textContent = t(REPORT_COPY[reportState]);
      } else if (reportOutcome.kind === 'ok' && isReportRow(reportOutcome.row)) {
        reportBody.innerHTML = `<div class="whitespace-pre-wrap">${esc(reportOutcome.row.markdown)}</div>`;
      } else {
        // Cannot happen — `aiFeatureState` only returns 'ready' when this holds — but
        // keeps the branch total rather than rendering nothing if that ever drifts.
        reportBody.textContent = t('transcript.reportNone');
      }

      sentimentSection.classList.remove('hidden');
      const sentimentOutcome = classifyAiFetch(sentimentSettled);
      const sentimentState = aiFeatureState(
        sentimentOutcome,
        isSentimentRow,
        transcriptStatus,
        aiRequested,
      );
      if (sentimentState !== 'ready') {
        sentimentBody.textContent = t(SENTIMENT_COPY[sentimentState]);
      } else if (sentimentOutcome.kind === 'ok' && isSentimentRow(sentimentOutcome.row)) {
        const r = sentimentOutcome.row.result;
        const speakersHtml = r.speakers
          .map((s: { name?: unknown; mood?: unknown; score?: unknown }) => {
            const mood = typeof s.mood === 'string' ? s.mood : null;
            const score = typeof s.score === 'number' ? s.score : null;
            return `<div class="flex justify-between border-b border-line py-1.5 last:border-0">
                <span>${esc(s.name)}</span>
                <span class="text-muted">${mood ? esc(t(sentimentMoodKey(mood))) : '—'} (${formatSentimentScore(score)})</span>
              </div>`;
          })
          .join('');
        const momentsHtml = r.key_moments.length
          ? `<ul class="mt-1 list-disc pl-5">${r.key_moments
              .map((m: { label?: unknown; score?: unknown }) => {
                const score = typeof m.score === 'number' ? m.score : null;
                return `<li>${esc(m.label)} (${formatSentimentScore(score)})</li>`;
              })
              .join('')}</ul>`
          : '';
        sentimentBody.innerHTML = `
          <div class="flex items-baseline gap-2">
            <span class="font-semibold">${esc(t('transcript.sentimentOverall'))}:</span>
            <span>${esc(t(sentimentMoodKey(r.overall.mood)))} (${formatSentimentScore(r.overall.score)})</span>
          </div>
          <div class="mt-3 text-xs font-semibold text-muted">${esc(t('transcript.sentimentBySpeaker'))}</div>
          <div>${speakersHtml}</div>
          ${
            momentsHtml
              ? `<div class="mt-3 text-xs font-semibold text-muted">${esc(t('transcript.sentimentKeyMoments'))}</div>${momentsHtml}`
              : ''
          }`;
      } else {
        // Cannot happen — `aiFeatureState` only returns 'ready' when this holds — but
        // keeps the branch total rather than rendering nothing if that ever drifts.
        sentimentBody.textContent = t('transcript.sentimentNone');
      }
    } catch (e) {
      // `getSessionReport`/`getSessionSentiment` do not throw today (lib/api.ts's
      // `request()` catches its own fetch failures), but this must not silently vanish
      // as an unhandled rejection if that ever changes.
      console.error('AI summary/sentiment failed to load', e);
      reportSection.classList.remove('hidden');
      sentimentSection.classList.remove('hidden');
      reportBody.textContent = t('transcript.reportError');
      sentimentBody.textContent = t('transcript.sentimentError');
    }
  }

  onPage('tools', async () => {
    const ctx = await boot();
    if (!ctx) return;
    const t = useTranslations(ctx.lang as Locale);
    const params = new URLSearchParams(location.search);
    const sessionId = params.get('session') ?? '';
    // Set by phone/detail.astro's link into this page (#hotfix-0.16.1): a phone call is
    // never room-recorded, so the room-recording control below is suppressed for it.
    const sessionKind = params.get('kind');
    // `1`/`0` from `call.ai_analysis_requested` (server hotfix 1.58.5); absent (`null`)
    // for a browser call or an older server that has not shipped the flag — kept as
    // `undefined` rather than guessed at, so aiFeatureState falls back to the
    // transcript-status heuristic instead of a false "not requested".
    const aiParam = params.get('ai');
    const aiRequested = aiParam === null ? undefined : aiParam === '1';
    const msg = document.getElementById('msg')!;
    const body = document.getElementById('body')!;
    if (!sessionId) {
      location.href = `/${ctx.lang}/history/`;
      return;
    }
    if (!showsRoomRecording(sessionKind)) {
      document.getElementById('rec-load')?.classList.add('hidden');
    }

    const res = await getTranscript(sessionId, ctx.lang);
    if (!res.ok || !res.data) {
      msg.textContent = t('transcript.none');
      return;
    }
    const doc = res.data;
    void loadAiSections(sessionId, doc.status, aiRequested, t);
    if (doc.status === 'processing' || doc.status === 'none') {
      msg.textContent = t(
        doc.status === 'processing' ? 'transcript.processing' : 'transcript.none',
      );
      return;
    }
    if (doc.status === 'failed') {
      msg.textContent = t('transcript.failed');
      return;
    }

    // A 'live' transcript is reconstructed from the realtime call transcript (no
    // cloud recording). Translate/export/playback all need the recording-derived
    // transcript, so for live we show just the text plus a one-line explainer.
    const isLive = doc.source === 'live';
    if (isLive) {
      msg.textContent = t('transcript.liveOnly');
      msg.className = 'mt-4 text-sm text-muted';
    } else {
      msg.classList.add('hidden');
      document.getElementById('tools')!.classList.replace('hidden', 'flex');
    }

    const renderSegments = (segs: Segment[]) => {
      body.innerHTML = segs
        .map(
          (s) => `<div class="card py-3">
            <div class="text-xs font-semibold text-brand">${esc(s.speaker_name)}</div>
            <div class="mt-1">${esc(s.text)}</div>
          </div>`,
        )
        .join('');
    };
    const renderText = (text: string) => {
      body.innerHTML = `<div class="card whitespace-pre-wrap">${esc(text)}</div>`;
    };
    renderSegments(doc.segments ?? []);

    // Translate / original toggle.
    const sel = document.getElementById('lang-sel') as HTMLSelectElement;
    sel.addEventListener('change', async () => {
      const target = sel.value;
      if (!target) {
        renderSegments(doc.segments ?? []);
        return;
      }
      body.innerHTML = `<div class="card text-muted">${esc(t('transcript.translating'))}</div>`;
      const r = await translateTranscript(sessionId, target);
      if (r.ok && r.data) renderText(r.data.text);
      else body.innerHTML = `<div class="card text-danger">${esc(t('common.error'))}</div>`;
    });

    // Export.
    document
      .getElementById('ex-txt')!
      .addEventListener('click', () =>
        downloadTranscript(sessionId, 'txt', sel.value || undefined),
      );
    document
      .getElementById('ex-pdf')!
      .addEventListener('click', () => downloadTranscript(sessionId, 'pdf'));

    // Recording playback (1h signed URL).
    document.getElementById('rec-load')!.addEventListener('click', async () => {
      const r = await recordingUrl(sessionId);
      const player = document.getElementById('player') as HTMLVideoElement;
      if (r.ok && r.data?.url) {
        player.src = r.data.url;
        player.classList.remove('hidden');
        void player.play().catch(() => {});
      } else {
        alert(t('transcript.noRecording'));
      }
    });
  });
</script>
