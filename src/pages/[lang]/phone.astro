---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localePaths, isLocale, DEFAULT_LOCALE, useTranslations } from '../../lib/i18n';
import SectionNav from '../../components/phone/SectionNav.astro';

export function getStaticPaths() {
  return localePaths();
}

const lang = isLocale(Astro.params.lang) ? Astro.params.lang : DEFAULT_LOCALE;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('phone.title')} chrome>
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold">{t('phone.title')}</h1>
      <p class="mt-0.5 max-w-2xl text-sm text-muted">{t('phone.subtitle')}</p>
    </div>
  </div>

  <!--
    The section's own landing page carried a hand-built link to settings and no tab bar,
    which is how it ended up the one href in this repo missing its trailing slash
    (`trailingSlash: 'always'`): every other link goes through `localizePath`, which
    appends it unconditionally. The tab bar carries settings now, and `SectionNav`'s
    `dialer` variant stops being a branch nothing reaches.
  -->
  <SectionNav lang={lang} current="dialer" />

  <!--
    The call's state is announced, not merely coloured (R30). `aria-live="assertive"`
    because a phone call changing state is exactly the kind of thing that must interrupt:
    "connected" means the far end can now hear you.
  -->
  <p id="phase-live" class="sr-only" role="status" aria-live="assertive" aria-atomic="true"></p>

  <div id="voip-off" class="card mt-6 hidden">
    <p class="text-sm">{t('phone.disabled')}</p>
    <p class="mt-1 text-sm text-muted">{t('phone.disabledAdmin')}</p>
  </div>

  <div id="voip-on" class="mt-6 hidden grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <!-- ---------------- Dialer ---------------- -->
    <section class="card" aria-labelledby="dialer-h">
      <h2 id="dialer-h" class="text-lg font-semibold">{t('phone.new')}</h2>

      <form id="dialer" class="mt-4 grid gap-4" novalidate>
        <div>
          <label for="contact" class="label">{t('phone.contacts.pick')}</label>
          <select id="contact" class="field mt-1">
            <option value="">{t('phone.contacts.noContact')}</option>
          </select>
        </div>

        <div>
          <label for="number" class="label">{t('phone.number')}</label>
          <input
            id="number"
            name="number"
            type="tel"
            inputmode="tel"
            autocomplete="tel"
            class="field mt-1"
            placeholder={t('phone.numberPh')}
            aria-describedby="number-hint number-error"
            required
          />
          <p id="number-hint" class="mt-1 text-xs text-muted">{t('phone.numberHint')}</p>
          <!-- Errors are text, adjacent to the field, and announced — never a red border alone. -->
          <p id="number-error" class="mt-1 hidden text-xs text-danger" role="alert"></p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="my-lang" class="label">{t('phone.myLanguage')}</label>
            <select id="my-lang" class="field mt-1"></select>
          </div>
          <div>
            <label for="their-lang" class="label">{t('phone.recipientLanguage')}</label>
            <select id="their-lang" class="field mt-1"></select>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="tier" class="label">{t('phone.tier')}</label>
            <select id="tier" class="field mt-1"></select>
          </div>
          <div>
            <label for="project" class="label">{t('phone.project')}</label>
            <select id="project" class="field mt-1">
              <option value="">{t('phone.noProject')}</option>
            </select>
          </div>
        </div>

        <div>
          <label for="caller-id" class="label">{t('phone.callerId')}</label>
          <select id="caller-id" class="field mt-1">
            <option value="">{t('phone.callerIdDefault')}</option>
          </select>
        </div>

        <fieldset class="grid gap-2">
          <legend class="label">{t('phone.disclosure.title')}</legend>
          <label class="flex items-center gap-2 text-sm">
            <input id="opt-record" type="checkbox" class="checkbox" />
            {t('phone.record')}
          </label>
          <label class="flex items-center gap-2 text-sm">
            <input id="opt-transcribe" type="checkbox" class="checkbox" checked />
            {t('phone.transcribe')}
          </label>
          <label class="flex items-center gap-2 text-sm">
            <input id="opt-ai" type="checkbox" class="checkbox" />
            {t('phone.aiAnalysis')}
            <span id="ai-hint" class="hidden text-xs text-muted"
              >{t('phone.aiNeedsTranscript')}</span
            >
          </label>
        </fieldset>

        <!-- What the RECIPIENT will hear, shown before the call so nobody is surprised. -->
        <div id="disclosure" class="rounded-lg border border-line bg-base p-3 text-sm">
          <div class="font-medium">{t('phone.disclosure.title')}</div>
          <p id="disclosure-body" class="mt-1 text-muted"></p>
          <p id="disclosure-ask" class="mt-1 hidden text-muted"></p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button id="call" type="submit" class="btn-primary">{t('phone.call')}</button>
          <button id="end" type="button" class="btn-ghost hidden">{t('phone.end')}</button>
          <!--
            The dashboard places the call; the app carries the audio. Microphone capture,
            translated playback and subtitles have lived there since the beginning, and a
            second implementation of the hardest part of the product is not worth saving
            one tab. Opened in a new tab so hanging up here stays available.
          -->
          <a id="join" class="btn-ghost hidden" target="_blank" rel="noopener" href="#"
            >{t('phone.join')}</a
          >
          <button id="video" type="button" class="btn-ghost hidden"
            >{t('phone.upgradeVideo')}</button
          >
          <span id="phase" class="badge"></span>
        </div>
        <p id="join-hint" class="hidden text-xs text-muted">{t('phone.joinHint')}</p>
        <!--
          The link is shown rather than sent: the recipient is on a telephone and there is
          no channel from here to them. The caller is already talking to the person.
        -->
        <div id="video-box" class="hidden rounded-lg border border-line bg-base p-3 text-sm">
          <p class="text-muted">{t('phone.videoHint')}</p>
          <div class="mt-2 flex flex-wrap items-center gap-2">
            <input
              id="video-url"
              type="text"
              readonly
              class="field min-w-0 flex-1 font-mono text-xs"
              aria-label={t('phone.upgradeVideo')}
            />
            <button id="video-copy" type="button" class="btn-ghost">{t('common.copy')}</button>
          </div>
          <p id="video-status" class="mt-1 text-xs text-muted" role="status"></p>
        </div>

        <p id="call-error" class="hidden text-sm text-danger" role="alert"></p>
        <!--
          A refusal the user can act on gets a way out. `insufficient_credits` is the one
          refusal whose fix is one click away, and leaving the user to find the credits
          page themselves is the difference between a wall and a door.
        -->
        <a id="call-error-cta" class="btn-ghost hidden self-start text-sm" href="#"></a>
      </form>
    </section>

    <!-- ---------------- Cost + recent ---------------- -->
    <aside class="grid gap-6">
      <section class="card" aria-labelledby="cost-h">
        <h2 id="cost-h" class="text-sm font-semibold">{t('phone.estimate')}</h2>
        <div class="mt-2 flex items-baseline gap-2">
          <span id="rate" class="text-3xl font-bold">—</span>
          <span class="text-sm text-muted">{t('phone.perMinute')}</span>
        </div>
        <dl class="mt-3 grid gap-1 text-sm">
          <div class="flex justify-between gap-2">
            <dt class="text-muted">{t('phone.balance')}</dt>
            <dd id="balance">—</dd>
          </div>
          <div class="flex justify-between gap-2">
            <dt class="text-muted">{t('phone.reserve')}</dt>
            <dd id="reserve">—</dd>
          </div>
        </dl>
        <p class="mt-2 text-xs text-muted">{t('phone.reserveHint')}</p>
      </section>

      <section class="card" aria-labelledby="recent-h">
        <div class="flex items-center justify-between gap-2">
          <h2 id="recent-h" class="text-sm font-semibold">{t('phone.recent')}</h2>
        </div>
        <div id="recent" class="mt-3 text-sm text-muted">{t('common.loading')}</div>
      </section>
    </aside>
  </div>
</BaseLayout>

<script>
  import { onPage } from '../../scripts/nav';
  import { boot } from '../../scripts/app-boot';
  import {
    currentOrgId,
    dialVoipCall,
    getEngines,
    getLanguageCatalogue,
    getVoipCalls,
    getVoipSettings,
    createVoipVideoInvite,
    hangUpVoipCall,
    listProjects,
    listVoipContacts,
    getVoipContact,
    listVoipNumbers,
    quoteVoipCall,
    getVoipCall,
    type VoipQuote,
  } from '../../lib/api';
  import { useTranslations, type Locale } from '../../lib/i18n';
  import {
    announcement,
    canHangUp,
    canJoin,
    disclosureSummaryKey,
    formatCredits,
    formatDuration,
    isTerminal,
    joinUrl,
    looksDialable,
    normaliseDestination,
    phaseFromStatus,
    refusalKey,
    willAskConsent,
    type CallPhase,
  } from '../../scripts/phone-dialer';
  import {
    engineById,
    groupedLanguageOptions,
    keepLanguage,
    languageForNumber,
    primaryNumber,
    usableCallerIds,
    validateDial,
    type EngineOption,
    type LanguageCatalogue,
  } from '../../scripts/phone-catalogue';

  onPage('dialer', async () => {
    const ctx = await boot();
    if (!ctx) return;
    const t = useTranslations(ctx.lang as Locale);
    const locale = ctx.lang;
    const org = ctx.activeOrg.id ?? currentOrgId();
    if (!org) return;

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
    const on = $('voip-on');
    const off = $('voip-off');

    const settings = await getVoipSettings(org);
    // 404 means the feature is off for the whole deployment; `enabled: false` means this
    // organisation has not turned it on. Both land the user in the same place, but only
    // the second one is something an admin here can fix.
    if (!settings.ok || !settings.data?.enabled) {
      off?.classList.remove('hidden');
      return;
    }
    on?.classList.remove('hidden');
    on?.classList.add('grid');

    const number = $<HTMLInputElement>('number');
    const numberError = $('number-error');
    const optRecord = $<HTMLInputElement>('opt-record');
    const optTranscribe = $<HTMLInputElement>('opt-transcribe');
    const optAi = $<HTMLInputElement>('opt-ai');
    const aiHint = $('ai-hint');
    const rate = $('rate');
    const balance = $('balance');
    const reserve = $('reserve');
    const phaseBadge = $('phase');
    const phaseLive = $('phase-live');
    const callBtn = $<HTMLButtonElement>('call');
    const endBtn = $<HTMLButtonElement>('end');
    const joinLink = $<HTMLAnchorElement>('join');
    const joinHint = $('join-hint');
    const videoBtn = $<HTMLButtonElement>('video');
    const videoBox = $('video-box');
    const videoUrl = $<HTMLInputElement>('video-url');
    const videoStatus = $('video-status');
    const videoCopy = $<HTMLButtonElement>('video-copy');
    const callError = $('call-error');
    const disclosureBody = $('disclosure-body');
    const disclosureAsk = $('disclosure-ask');
    const errorCta = $<HTMLAnchorElement>('call-error-cta');
    const myLang = $<HTMLSelectElement>('my-lang');
    const theirLang = $<HTMLSelectElement>('their-lang');
    const tierSel = $<HTMLSelectElement>('tier');
    const projectSel = $<HTMLSelectElement>('project');
    const callerIdSel = $<HTMLSelectElement>('caller-id');
    const contactSel = $<HTMLSelectElement>('contact');

    let phase: CallPhase = 'idle';
    let activeCall: string | null = null;
    let activeRoom: string | null = null;
    let poll: number | undefined;

    // Where the app lives. Same default as the header's link, so one deployment cannot end
    // up pointing the two at different origins.
    const APP_URL = import.meta.env.PUBLIC_APP_URL || 'https://app.voxtranslate.app';

    function setPhase(next: CallPhase) {
      const said = announcement(phase, next, t);
      phase = next;
      if (phaseBadge) phaseBadge.textContent = next === 'idle' ? '' : t(`phase.${next}`);
      // Announced once per change, not on every poll.
      if (said && phaseLive) phaseLive.textContent = said;
      if (callBtn) callBtn.classList.toggle('hidden', canHangUp(next));
      if (endBtn) endBtn.classList.toggle('hidden', !canHangUp(next));

      // The join link is offered only while the call is live. Afterwards it would lead
      // into a room nobody is in, which reads as a broken call rather than a finished one.
      const href = canJoin(next, activeRoom) ? joinUrl(APP_URL, activeRoom) : null;
      if (joinLink) {
        if (href) joinLink.setAttribute('href', href);
        else joinLink.removeAttribute('href');
        joinLink.classList.toggle('hidden', !href);
      }
      joinHint?.classList.toggle('hidden', !href);

      // Video is an upgrade to a live call, so it is offered on the same terms as the
      // join link — and withdrawn the moment the call is over, along with the link that
      // was already minted for it.
      videoBtn?.classList.toggle('hidden', !canHangUp(next));
      if (isTerminal(next)) {
        videoBox?.classList.add('hidden');
        if (videoUrl) videoUrl.value = '';
      }
      if (isTerminal(next)) activeRoom = null;
    }

    function showError(el: HTMLElement | null, code: string | null) {
      if (!el) return;
      if (!code) {
        el.classList.add('hidden');
        el.textContent = '';
        return;
      }
      el.textContent = t(refusalKey(code));
      el.classList.remove('hidden');
    }

    /**
     * Show a message that is already a translation key rather than a server reason code.
     * Client-side refusals (`phone.error.*`) and server ones (`phone.reason.*`) both land
     * here; only the lookup differs.
     */
    function showKeyed(el: HTMLElement | null, key: string | null) {
      if (!el) return;
      if (!key) {
        el.classList.add('hidden');
        el.textContent = '';
        return;
      }
      el.textContent = t(key);
      el.classList.remove('hidden');
    }

    /**
     * Offer a way out of the one refusal that has one.
     *
     * Mirrors `resolveHaErrorCta` in the help-assistant panel: a dead end the product
     * knows how to fix should not make the user go looking for the fix.
     */
    function syncErrorCta(code: string | null) {
      if (!errorCta) return;
      const recoverable = code === 'insufficient_credits' || code === 'credits_exhausted';
      errorCta.classList.toggle('hidden', !recoverable);
      if (recoverable) {
        errorCta.setAttribute('href', `/${locale}/credits/#plans`);
        errorCta.textContent = t('credits.buy');
      } else {
        errorCta.removeAttribute('href');
        errorCta.textContent = '';
      }
    }

    // AI analysis has nothing to analyse without a transcript. Reflected in the UI so the
    // checkbox is not silently ignored by the server.
    function syncAi() {
      const ok = !!optTranscribe?.checked;
      if (optAi) optAi.disabled = !ok;
      if (!ok && optAi) optAi.checked = false;
      aiHint?.classList.toggle('hidden', ok);
    }

    function renderDisclosure(q: VoipQuote) {
      if (disclosureBody) disclosureBody.textContent = t(disclosureSummaryKey(q));
      const ask = willAskConsent(q);
      disclosureAsk?.classList.toggle('hidden', !ask);
      if (ask && disclosureAsk) disclosureAsk.textContent = t('phone.disclosure.willAsk');
    }

    let quoteSeq = 0;
    async function refreshQuote() {
      const raw = number?.value ?? '';
      showError(numberError, null);
      if (!looksDialable(raw)) {
        if (rate) rate.textContent = '—';
        if (reserve) reserve.textContent = '—';
        return;
      }
      const seq = ++quoteSeq;
      // Everything that moves the price or the gate. The shipped dialer sent only the
      // destination and the capture flags, so the quote was always priced on the DEFAULT
      // engine — change the tier and the figure did not move — and the server could not
      // run the project or caller-id checks it runs on dial.
      const res = await quoteVoipCall(org, {
        destination: normaliseDestination(raw),
        engine_id: tierSel?.value || undefined,
        target_language: theirLang?.value || undefined,
        project_id: projectSel?.value || null,
        caller_id: callerIdSel?.value || null,
        record: !!optRecord?.checked,
        transcribe: !!optTranscribe?.checked,
        ai_analysis: !!optAi?.checked,
      });
      // Typing races the network; only the newest answer may paint.
      if (seq !== quoteSeq) return;

      if (!res.ok || !res.data) {
        const code = (res.data as unknown as { error?: string } | null)?.error ?? null;
        showError(numberError, code);
        if (rate) rate.textContent = '—';
        if (reserve) reserve.textContent = '—';
        return;
      }
      const q = res.data;
      if (rate) rate.textContent = `$${Number(q.price_per_minute).toFixed(4)}`;
      if (balance) balance.textContent = `$${formatCredits(q.balance_credits)}`;
      if (reserve) reserve.textContent = `$${formatCredits(q.reserve_credits)}`;
      renderDisclosure(q);
    }

    // ---- catalogues ---------------------------------------------------------
    //
    // The selects shipped in 1.50.0 declared in markup and never populated. Because
    // `select.value` is `''` and not `undefined`, the `?? 'en'` fallback in the submit
    // handler never fired and every call carried an EMPTY language (spec 0112 D1). They
    // are filled here, from the same two catalogues the call app reads.

    let engines: EngineOption[] = [];
    let catalogue: LanguageCatalogue = { languages: [], regions: [] };
    const requireProject = settings.data?.require_project ?? false;

    function placeholder(select: HTMLSelectElement, label: string) {
      const opt = document.createElement('option');
      opt.value = '';
      opt.textContent = label;
      select.appendChild(opt);
    }

    function fillLanguages(
      select: HTMLSelectElement | null,
      allowed: readonly string[],
      keep: string,
    ) {
      if (!select) return;
      select.replaceChildren();
      placeholder(select, t('phone.chooseLanguage'));
      for (const group of groupedLanguageOptions(catalogue, allowed)) {
        const optgroup = document.createElement('optgroup');
        optgroup.label = group.region;
        for (const option of group.options) {
          const el = document.createElement('option');
          el.value = option.code;
          el.textContent = option.label;
          optgroup.appendChild(el);
        }
        select.appendChild(optgroup);
      }
      // Keep the choice when the engine still speaks it. When it does not, fall back to
      // the empty placeholder rather than to the first option: silently *replacing* the
      // user's language is the same class of bug as silently sending an empty one.
      select.value = allowed.includes(keep) ? keep : '';
    }

    function currentEngine(): EngineOption | null {
      return engineById(engines, tierSel?.value ?? '');
    }

    function refreshLanguages() {
      const engine = currentEngine();
      const inputs = engine?.input_languages ?? [];
      const outputs = engine?.output_languages ?? [];
      const mine = myLang?.value ?? '';
      const theirs = theirLang?.value ?? '';
      fillLanguages(myLang, inputs, keepLanguage(engine, mine, 'input') ? mine : '');
      fillLanguages(theirLang, outputs, keepLanguage(engine, theirs, 'output') ? theirs : '');
      // The caller is the person sitting here, so their dashboard language is a defensible
      // default. The recipient's is not guessable from anything we know, and guessing it
      // would put a stranger's call in the wrong language.
      if (myLang && !myLang.value && inputs.includes(locale)) myLang.value = locale;
    }

    async function loadCatalogues() {
      const [engineRes, langRes, projectRes, numberRes] = await Promise.all([
        getEngines(),
        getLanguageCatalogue(),
        listProjects(org),
        listVoipNumbers(org),
      ]);

      engines = engineRes.data?.engines ?? [];
      if (langRes.data) {
        catalogue = { languages: langRes.data.languages, regions: langRes.data.regions };
      }

      if (tierSel) {
        tierSel.replaceChildren();
        for (const engine of engines) {
          const el = document.createElement('option');
          el.value = engine.id;
          // `/min` is copy. `phone.perMinute` already says it in five languages, right
          // beside the rate in the estimate card.
          el.textContent = `${engine.display_name} · $${engine.rate_per_minute.toFixed(4)} ${t(
            'phone.perMinute',
          )}`;
          tierSel.appendChild(el);
        }
        // The org's configured default, when it still exists in the catalogue.
        const preferred = settings.data?.default_engine_id ?? '';
        if (preferred && engines.some((e) => e.id === preferred)) tierSel.value = preferred;
      }
      refreshLanguages();

      if (projectSel) {
        for (const project of projectRes.data ?? []) {
          const el = document.createElement('option');
          el.value = project.id;
          el.textContent = project.name;
          projectSel.appendChild(el);
        }
      }

      // The address book (spec 0114). Choosing somebody fills the number AND the language
      // that number speaks — which is the whole reason the language lives on the number.
      if (contactSel) {
        const contacts = await listVoipContacts(org, { limit: 200 });
        for (const contact of contacts.data?.contacts ?? []) {
          const el = document.createElement('option');
          el.value = contact.id;
          el.textContent = contact.company ? `${contact.name} · ${contact.company}` : contact.name;
          contactSel.appendChild(el);
        }
      }

      if (callerIdSel) {
        // Only numbers that may actually be presented. `resolve_caller_id` refuses the
        // rest, so offering one would produce a refusal after the user had chosen it.
        for (const n of usableCallerIds(numberRes.data?.numbers ?? [])) {
          const el = document.createElement('option');
          el.value = n.e164;
          el.textContent = n.label ? `${n.label} · ${n.e164}` : n.e164;
          callerIdSel.appendChild(el);
          if (n.is_default) callerIdSel.value = n.e164;
        }
      }
    }

    contactSel?.addEventListener('change', async () => {
      const id = contactSel.value;
      if (!id) return;
      const res = await getVoipContact(org, id);
      const contact = res.data;
      if (!contact) return;

      const chosen = primaryNumber(contact.numbers);
      if (!chosen || !number) return;
      number.value = chosen.e164;

      // Preselected, never forced: the language is offered from what we know about this
      // number, and the caller can still change it for this call (R5). A number with no
      // language recorded leaves the select alone rather than guessing.
      const language = languageForNumber(contact.numbers, chosen.e164);
      if (language && theirLang && keepLanguage(currentEngine(), language, 'output')) {
        theirLang.value = language;
      }
      // A project the contact belongs to, when none has been chosen yet.
      if (projectSel && !projectSel.value && contact.projects.length === 1) {
        projectSel.value = contact.projects[0].id;
      }
      void refreshQuote();
    });

    // Changing tier can strip a language the previous engine supported.
    tierSel?.addEventListener('change', () => {
      refreshLanguages();
      void refreshQuote();
    });

    let debounce: number | undefined;
    number?.addEventListener('input', () => {
      window.clearTimeout(debounce);
      debounce = window.setTimeout(refreshQuote, 350);
    });
    for (const el of [optRecord, optTranscribe, optAi]) {
      el?.addEventListener('change', () => {
        syncAi();
        void refreshQuote();
      });
    }
    // The recipient's language, the project and the caller id all reach the quote now, so
    // changing one has to re-ask. `tierSel` has its own handler below; it refills the
    // language selects first and then re-quotes.
    for (const el of [theirLang, projectSel, callerIdSel]) {
      el?.addEventListener('change', () => void refreshQuote());
    }
    syncAi();

    async function pollCall() {
      if (!activeCall) return;
      const res = await getVoipCall(org, activeCall);
      if (!res.ok || !res.data) return;
      const next = phaseFromStatus(res.data.status);
      setPhase(next);
      if (isTerminal(next)) {
        window.clearInterval(poll);
        activeCall = null;
        if (res.data.failure_reason) {
          showError(callError, res.data.failure_reason);
          syncErrorCta(res.data.failure_reason);
        }
        void loadRecent();
      }
    }

    $('dialer')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      showError(callError, null);
      showError(numberError, null);
      syncErrorCta(null);

      // Nothing leaves the browser until the request is complete. The shipped dialer
      // sent whatever the selects happened to hold, which was the empty string.
      const problem = validateDial(
        {
          destination: number?.value ?? '',
          sourceLanguage: myLang?.value ?? '',
          targetLanguage: theirLang?.value ?? '',
          engineId: tierSel?.value ?? '',
          projectId: projectSel?.value || null,
        },
        { engines, requireProject },
      );
      if (problem) {
        // The message goes where the user is looking — beside the number for a number
        // problem, beside the button they just pressed otherwise — and focus moves to the
        // control that needs fixing, so the fix is reachable without hunting for it.
        const control: Record<string, HTMLElement | null> = {
          destination: number,
          source: myLang,
          target: theirLang,
          tier: tierSel,
          project: projectSel,
        };
        showKeyed(problem.field === 'destination' ? numberError : callError, problem.key);
        control[problem.field]?.focus();
        return;
      }

      setPhase('preparing');

      const res = await dialVoipCall(org, {
        destination: normaliseDestination(number?.value ?? ''),
        // No `?? 'en'` here: `validateDial` above has already refused an unset language,
        // and the fallback was what hid the bug in the first place.
        source_language: myLang?.value ?? '',
        target_language: theirLang?.value ?? '',
        engine_id: tierSel?.value || undefined,
        project_id: projectSel?.value || null,
        caller_id: callerIdSel?.value || null,
        record: !!optRecord?.checked,
        transcribe: !!optTranscribe?.checked,
        ai_analysis: !!optAi?.checked,
      });

      if (!res.ok || !res.data) {
        const code = (res.data as unknown as { error?: string } | null)?.error ?? null;
        setPhase('failed');
        showError(callError, code);
        syncErrorCta(code);
        return;
      }
      activeCall = res.data.call_id;
      // Without this the caller is not in the call at all: the engine translates a speaker
      // into the room's OTHER languages, and a room holding only the telephone has none.
      activeRoom = res.data.room ?? null;
      setPhase(phaseFromStatus(res.data.status));
      // The authoritative state comes from the server, which learns it from the provider's
      // webhooks. Nothing here guesses that a call connected.
      poll = window.setInterval(pollCall, 1500);
    });

    videoBtn?.addEventListener('click', async () => {
      if (!activeCall) return;
      const res = await createVoipVideoInvite(org, activeCall);
      if (!res.ok || !res.data) {
        // A failed upgrade must never disturb the call: report it and leave everything
        // else exactly as it was.
        if (videoStatus) videoStatus.textContent = t('phone.videoUnavailable');
        videoBox?.classList.remove('hidden');
        return;
      }
      if (videoUrl) videoUrl.value = res.data.url;
      if (videoStatus) videoStatus.textContent = '';
      videoBox?.classList.remove('hidden');
      videoUrl?.focus();
      videoUrl?.select();
    });

    videoCopy?.addEventListener('click', async () => {
      if (!videoUrl?.value) return;
      try {
        await navigator.clipboard.writeText(videoUrl.value);
        if (videoStatus) videoStatus.textContent = t('phone.videoCopied');
      } catch {
        // Clipboard access can be refused. The link is already selected and on screen, so
        // there is nothing to recover from — say nothing rather than raise an error for
        // something the user can simply copy by hand.
        videoUrl.select();
      }
    });

    endBtn?.addEventListener('click', async () => {
      if (!activeCall) return;
      setPhase('ending');
      await hangUpVoipCall(org, activeCall);
    });

    async function loadRecent() {
      const el = $('recent');
      if (!el) return;
      const res = await getVoipCalls(org, { limit: 8 });
      if (!res.ok || !res.data) {
        el.textContent = t('common.connError');
        return;
      }
      const calls = res.data.calls;
      el.replaceChildren();
      if (calls.length === 0) {
        const empty = document.createElement('p');
        empty.textContent = t('phone.empty');
        const hint = document.createElement('p');
        hint.className = 'mt-1 text-xs';
        hint.textContent = t('phone.emptyHint');
        el.append(empty, hint);
        return;
      }

      // Text, never markup. `calls.astro` renders the same fields through `textContent`
      // and says why; this list was built with `innerHTML` and string interpolation, so
      // the same feature had two rules for the same data. The masked number comes from
      // our own server, which is an argument for not worrying and not an argument for
      // interpolating it into HTML.
      for (const c of calls) {
        const row = document.createElement('a');
        row.href = `/${locale}/phone/detail/?id=${encodeURIComponent(c.id)}`;
        row.className =
          'flex items-center justify-between gap-2 border-b border-line py-2 last:border-0';

        const left = document.createElement('span');
        const number = document.createElement('span');
        number.className = 'font-mono';
        number.textContent = c.recipient_masked;
        const meta = document.createElement('span');
        meta.className = 'block text-xs text-muted';
        // Status is a word, never a colour on its own.
        meta.textContent = `${new Date(c.started_at).toLocaleString()} · ${t(
          `phase.${phaseFromStatus(c.status)}`,
        )}`;
        left.append(number, meta);

        const right = document.createElement('span');
        right.className = 'text-right text-xs';
        const duration = document.createElement('span');
        duration.className = 'block';
        duration.textContent = formatDuration(c.duration_seconds);
        const cost = document.createElement('span');
        cost.className = 'block text-muted';
        cost.textContent = `$${formatCredits(c.credits_consumed)}`;
        right.append(duration, cost);

        row.append(left, right);
        el.appendChild(row);
      }
    }

    await loadCatalogues();
    await loadRecent();
  });
</script>
