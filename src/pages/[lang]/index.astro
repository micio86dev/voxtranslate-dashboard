---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localePaths, isLocale, DEFAULT_LOCALE, useTranslations } from '../../lib/i18n';

export function getStaticPaths() {
  return localePaths();
}

const lang = isLocale(Astro.params.lang) ? Astro.params.lang : DEFAULT_LOCALE;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('common.appName')} description={t('login.subtitle')}>
  <div class="mx-auto flex min-h-screen max-w-md flex-col justify-center px-4">
    <div class="card text-center">
      <img
        src="/apple-touch-icon.png"
        alt="VoxTranslate"
        width="64"
        height="64"
        class="mx-auto mb-3 rounded-2xl"
      />
      <div class="mb-4 text-lg font-bold text-brand">VoxTranslate</div>
      <h1 class="text-2xl font-bold">{t('login.title')}</h1>
      <p class="mt-2 text-muted">{t('login.subtitle')}</p>
      <div id="gbtn" class="mt-6 flex justify-center"></div>
      <p id="err" class="mt-3 hidden text-sm text-danger">{t('login.error')}</p>
    </div>
  </div>
</BaseLayout>

<script>
  import { isLoggedIn, renderGoogleButton } from '../../lib/auth';

  const lang = document.documentElement.lang || 'en';
  const next = new URLSearchParams(location.search).get('next');
  const dest = next && next.startsWith('/') ? next : `/${lang}/dashboard/`;

  if (isLoggedIn()) {
    location.replace(dest);
  } else {
    const el = document.getElementById('gbtn');
    if (el) renderGoogleButton(el, () => location.replace(dest));
    document.addEventListener('vox-login-error', () =>
      document.getElementById('err')?.classList.remove('hidden'),
    );
  }
</script>
