---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localePaths, isLocale, DEFAULT_LOCALE, useTranslations, tList } from '../../lib/i18n';

export function getStaticPaths() {
  return localePaths();
}

const lang = isLocale(Astro.params.lang) ? Astro.params.lang : DEFAULT_LOCALE;
const t = useTranslations(lang);

// Plan feature bullets come from i18n (mirrors the marketing site's pricing copy).
const plans = [
  { id: 'business', popular: true, points: tList(lang, 'plans.business.points') },
  { id: 'enterprise', popular: false, points: tList(lang, 'plans.enterprise.points') },
] as const;
---

<BaseLayout lang={lang} title={t('credits.title')} chrome>
  <h1 class="text-2xl font-bold">{t('credits.title')}</h1>

  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    <div class="card">
      <div class="text-sm text-muted">{t('credits.balance')}</div>
      <div id="balance" class="mt-1 text-3xl font-bold">…</div>
      <div class="mt-4 flex flex-wrap gap-2">
        <button id="buy" class="btn-primary text-sm">{t('credits.buy')}</button>
        <button id="manage" class="btn-ghost text-sm">{t('credits.manage')}</button>
      </div>
    </div>
    <!-- Subscription box — status + all details (filled from the API at runtime). -->
    <div class="card">
      <div class="flex items-center justify-between gap-2">
        <div class="text-sm font-semibold">{t('sub.title')}</div>
        <span id="sub-status" class="badge"></span>
      </div>
      <div id="sub-body" class="mt-3 text-sm text-muted">{t('common.loading')}</div>
    </div>
  </div>

  <!-- Plan comparison + checkout (the banner deep-links here via #plans). -->
  <section id="plans" class="mt-10 scroll-mt-24">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 class="text-lg font-semibold">{t('plans.title')}</h2>
        <p class="mt-0.5 text-sm text-muted">{t('plans.subtitle')}</p>
      </div>
      <div
        class="inline-flex rounded-lg border border-line bg-base p-1 text-sm"
        role="group"
        aria-label={t('credits.interval')}
      >
        <button
          id="int-month"
          type="button"
          class="rounded-md px-3 py-1.5 font-medium transition"
          aria-pressed="true">{t('plans.monthly')}</button
        >
        <button
          id="int-year"
          type="button"
          class="rounded-md px-3 py-1.5 font-medium transition"
          aria-pressed="false">{t('plans.annual')}</button
        >
      </div>
    </div>

    <div class="mt-4 grid gap-4 md:grid-cols-2">
      {
        plans.map((p) => (
          <div
            class:list={[
              'card relative flex flex-col',
              p.popular && 'border-brand ring-1 ring-brand/30',
            ]}
            data-plan={p.id}
          >
            {p.popular && (
              <span class="badge absolute -top-3 left-6 border-brand bg-brand text-brand-ink">
                {t('plans.mostPopular')}
              </span>
            )}
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-lg font-bold">{t(`plans.${p.id}.name`)}</h3>
              <span class="plan-current badge hidden border-ok text-ok">{t('plans.current')}</span>
            </div>
            <p class="mt-1 text-sm text-muted">{t(`plans.${p.id}.tagline`)}</p>
            <div class="mt-3 flex items-baseline gap-1">
              <span class="plan-price text-3xl font-bold">{t(`plans.${p.id}.priceMonth`)}</span>
              <span class="plan-per text-sm text-muted">{t('plans.perMonth')}</span>
            </div>
            <p class="plan-alt mt-1 text-xs text-muted" />
            <ul class="mt-4 flex flex-1 flex-col gap-2 text-sm">
              {p.points.map((point) => (
                <li class="flex items-start gap-2">
                  <svg
                    class="mt-0.5 shrink-0 text-ok"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
            <button class="choose btn-primary mt-5 w-full" data-plan={p.id}>
              {t('plans.choose', { plan: t(`plans.${p.id}.name`) })}
            </button>
            <p class="plan-note mt-2 hidden text-center text-xs text-muted" />
          </div>
        ))
      }
    </div>

    <!-- The actual "what's the difference" explainer. -->
    <div class="card mt-4">
      <h3 class="text-sm font-semibold">{t('plans.vsTitle')}</h3>
      <div class="mt-2 grid gap-3 text-sm text-muted sm:grid-cols-2">
        <p>
          <span class="font-semibold text-ink">{t('plans.business.name')}</span> — {
            t('plans.vsBusiness')
          }
        </p>
        <p>
          <span class="font-semibold text-ink">{t('plans.enterprise.name')}</span> — {
            t('plans.vsEnterprise')
          }
        </p>
      </div>
    </div>
  </section>

  <!-- Invoices — the documents accounting actually needs, grouped by month. -->
  <section class="mt-8">
    <h2 class="text-lg font-semibold">{t('invoices.title')}</h2>
    <p class="mt-0.5 text-sm text-muted">{t('invoices.subtitle')}</p>
    <div id="invoices" class="mt-3 flex flex-col gap-4"></div>
    <p id="invoices-loading" class="card mt-3 text-center text-muted">{t('common.loading')}</p>
    <p id="invoices-empty" class="card mt-3 hidden text-center text-muted">
      {t('invoices.empty')}
    </p>
    <p id="invoices-error" class="card mt-3 hidden text-center text-warn">
      {t('invoices.loadError')}
    </p>
  </section>

  <h2 class="mt-8 text-lg font-semibold">{t('credits.transactions')}</h2>
  <div class="card mt-3 overflow-x-auto p-0">
    <table class="w-full text-sm">
      <thead class="border-b border-line text-left text-muted">
        <tr>
          <th class="px-4 py-3">{t('credits.date')}</th>
          <th class="px-4 py-3">{t('credits.type')}</th>
          <th class="px-4 py-3 text-right">{t('credits.amount')}</th>
        </tr>
      </thead>
      <tbody id="txns"></tbody>
    </table>
    <p id="no-txns" class="hidden px-4 py-6 text-center text-muted">{t('credits.noTxns')}</p>
  </div>
</BaseLayout>

<script>
  import { onPage } from '../../scripts/nav';
  import { boot } from '../../scripts/app-boot';
  import {
    billingPortal,
    getCredits,
    getOrgInvoicePdf,
    getOrgInvoices,
    getSubscription,
    purchaseCredits,
    subscribe,
    type InvoiceMonth,
    type SubscriptionDetail,
  } from '../../lib/api';
  import { useTranslations, type Locale } from '../../lib/i18n';
  import { isSubscriptionLive, subscriptionActions } from '../../lib/subscription';

  function esc(s: string): string {
    return s.replace(
      /[&<>"]/g,
      (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] || c,
    );
  }

  onPage('plans', async () => {
    const ctx = await boot();
    if (!ctx) return;
    const t = useTranslations(ctx.lang as Locale);
    const orgId = ctx.activeOrg.id;
    const fmt = (iso: string) => new Date(iso).toLocaleDateString(ctx.lang);

    const status = ctx.activeOrg.subscription_status;
    const currentPlan = ctx.activeOrg.plan;
    const isOwner = ctx.activeOrg.role === 'owner';
    // Which billing routes to offer. Both used to be inferred from
    // `subscription_status`, which lies for a gifted plan — see
    // `subscriptionActions`, where the rule now lives and is tested.
    const { canManage: hasCustomer, canSubscribe: canChoose } = subscriptionActions(ctx.activeOrg);

    const go = (url?: string | null) => {
      if (url) window.location.href = url;
      else alert(t('common.error'));
    };

    // The Billing Portal only exists once there's a customer, so hide "Manage
    // subscription" until then — otherwise it 409s and the user is told only
    // that "something went wrong".
    document.getElementById('manage')!.classList.toggle('hidden', !hasCustomer);

    // --- Subscription box: status + all details (DB + live Stripe overlay) ---
    const statusEl = document.getElementById('sub-status')!;
    const bodyEl = document.getElementById('sub-body')!;
    const STATUS_BADGE: Record<string, string> = {
      active: 'border-ok text-ok',
      past_due: 'border-warn text-warn',
      canceled: 'border-danger text-danger',
      none: '',
    };
    const fmtDate = (iso?: string | null) =>
      iso ? new Date(iso).toLocaleDateString(ctx.lang) : '';
    const fmtMoney = (cents?: number | null, currency?: string | null) =>
      typeof cents === 'number' && currency
        ? (cents / 100).toLocaleString(ctx.lang, {
            style: 'currency',
            currency: currency.toUpperCase(),
          })
        : '';
    const row = (label: string, value: string) =>
      value
        ? `<div class="flex justify-between gap-3 border-b border-line py-1.5 last:border-0">
            <dt class="text-muted">${esc(label)}</dt>
            <dd class="text-right font-medium text-ink">${esc(value)}</dd></div>`
        : '';

    const renderSubBox = (d: SubscriptionDetail) => {
      const raw = d.status || 'none';
      // A plan can lapse by DATE alone — a gifted subscription has no Stripe to
      // cancel it, so the stored status reads 'active' forever. Showing that
      // verbatim told users their plan was live while the server was already
      // refusing them, and the renewal line below said "cancels on <a date that
      // has passed>". Present the DERIVED state instead.
      const live = isSubscriptionLive(raw, d.current_period_end);
      const st = raw === 'active' && !live ? 'canceled' : raw;
      statusEl.textContent = t(`sub.status.${st}`);
      statusEl.className = `badge ${STATUS_BADGE[st] ?? ''}`;

      if (st === 'none') {
        bodyEl.innerHTML = `<p class="font-medium text-ink">${esc(t('sub.noneTitle'))}</p>
          <p class="mt-1">${esc(t('sub.noneBody'))}</p>`;
        return;
      }

      const interval = d.interval === 'year' ? t('plans.annual') : t('plans.monthly');
      const per = d.interval === 'year' ? t('plans.perYear') : t('plans.perMonth');
      const amount = fmtMoney(d.amount, d.currency);
      const planName = t(`plans.${d.plan}.name`);

      // Renewal / end line depends on where we are in the lifecycle.
      let renew = '';
      if (st === 'canceled') {
        const end = fmtDate(d.canceled_at || d.current_period_end);
        renew = end ? t('sub.endedOn', { date: end }) : '';
      } else if (d.cancel_at_period_end) {
        const end = fmtDate(d.cancel_at || d.current_period_end);
        renew = end ? t('sub.cancelsOn', { date: end }) : '';
      } else if (st === 'past_due') {
        renew = t('sub.pastDueNote');
      } else {
        const end = fmtDate(d.current_period_end);
        renew = end ? t('sub.renewsOn', { date: end }) : '';
      }

      const period =
        d.current_period_start && d.current_period_end
          ? `${fmtDate(d.current_period_start)} – ${fmtDate(d.current_period_end)}`
          : '';

      let card = '';
      if (d.card_brand && d.card_last4) {
        card = t('sub.card', { brand: d.card_brand, last4: d.card_last4 });
        if (d.card_exp_month && d.card_exp_year) {
          card += ` · ${t('sub.cardExp', {
            mm: String(d.card_exp_month).padStart(2, '0'),
            yyyy: d.card_exp_year,
          })}`;
        }
      }

      const warnTone = d.cancel_at_period_end || !live;
      bodyEl.innerHTML =
        '<dl>' +
        row(t('sub.plan'), planName) +
        row(t('sub.billing'), interval) +
        row(t('sub.amount'), amount ? `${amount} ${per}` : '') +
        row(t('sub.start'), fmtDate(d.start_date)) +
        row(t('sub.period'), period) +
        row(t('sub.payment'), card) +
        '</dl>' +
        (renew ? `<p class="mt-2 ${warnTone ? 'text-warn' : 'text-muted'}">${esc(renew)}</p>` : '');
    };

    {
      const r = await getSubscription(orgId);
      if (r.ok && r.data) renderSubBox(r.data);
      else {
        statusEl.classList.add('hidden');
        bodyEl.textContent = t('sub.loadError');
      }
    }

    // --- Plan comparison: billing-interval toggle ---------------------------
    const PLANS = ['business', 'enterprise'] as const;
    let interval: 'month' | 'year' = 'month';

    const monthBtn = document.getElementById('int-month')!;
    const yearBtn = document.getElementById('int-year')!;
    const applyInterval = () => {
      for (const p of PLANS) {
        const card = document.querySelector(`[data-plan="${p}"]`)!;
        const priceMonth = t(`plans.${p}.priceMonth`);
        const priceYear = t(`plans.${p}.priceYear`);
        const monthly = interval === 'month';
        card.querySelector('.plan-price')!.textContent = monthly ? priceMonth : priceYear;
        card.querySelector('.plan-per')!.textContent = monthly
          ? t('plans.perMonth')
          : t('plans.perYear');
        card.querySelector('.plan-alt')!.textContent = monthly
          ? t('plans.altYear', { price: priceYear })
          : t('plans.altMonth', { price: priceMonth });
      }
      for (const [btn, on] of [
        [monthBtn, interval === 'month'],
        [yearBtn, interval === 'year'],
      ] as const) {
        btn.setAttribute('aria-pressed', String(on));
        btn.classList.toggle('bg-surface', on);
        btn.classList.toggle('shadow-sm', on);
        btn.classList.toggle('text-ink', on);
        btn.classList.toggle('text-muted', !on);
      }
    };
    monthBtn.addEventListener('click', () => {
      interval = 'month';
      applyInterval();
    });
    yearBtn.addEventListener('click', () => {
      interval = 'year';
      applyInterval();
    });
    applyInterval();

    // --- Plan comparison: per-card state (current badge / checkout gating) ---
    for (const p of PLANS) {
      const card = document.querySelector(`[data-plan="${p}"]`)!;
      const choose = card.querySelector('.choose') as HTMLButtonElement;
      const badge = card.querySelector('.plan-current') as HTMLElement;
      const note = card.querySelector('.plan-note') as HTMLElement;

      badge.classList.toggle('hidden', !(hasCustomer && currentPlan === p));

      if (!canChoose) {
        // A live subscription: plan switches go through the portal, not checkout.
        choose.classList.add('hidden');
        note.textContent = t('plans.manageHint');
        note.classList.remove('hidden');
      } else if (!isOwner) {
        // Subscribing is owner-only (server-enforced); tell non-owners why.
        choose.disabled = true;
        note.textContent = t('plans.ownerOnly');
        note.classList.remove('hidden');
      } else {
        choose.addEventListener('click', async () => {
          choose.disabled = true;
          const r = await subscribe(orgId, p, interval);
          if (r.data?.url) window.location.href = r.data.url;
          else {
            choose.disabled = false;
            alert(t('common.error'));
          }
        });
      }
    }

    // --- Balance + transactions --------------------------------------------
    const res = await getCredits(orgId);
    if (res.ok && res.data) {
      document.getElementById('balance')!.textContent = String(res.data.balance);
      const txns = res.data.transactions ?? [];
      document.getElementById('no-txns')!.classList.toggle('hidden', txns.length > 0);
      document.getElementById('txns')!.innerHTML = txns
        .map(
          (x) => `<tr class="border-b border-line last:border-0">
            <td class="px-4 py-3 text-muted">${esc(fmt(x.created_at))}</td>
            <td class="px-4 py-3">${esc(x.type)}</td>
            <td class="px-4 py-3 text-right ${x.amount < 0 ? 'text-danger' : 'text-ok'}">${x.amount > 0 ? '+' : ''}${x.amount}</td>
          </tr>`,
        )
        .join('');
    }

    // --- Invoices ------------------------------------------------------------
    const invoicesEl = document.getElementById('invoices')!;
    const loadingEl = document.getElementById('invoices-loading')!;
    const emptyEl = document.getElementById('invoices-empty')!;
    const errorEl = document.getElementById('invoices-error')!;

    // `2026-08` → the month name in the viewer's locale. Parsed as UTC (the
    // server groups in UTC) so a negative-offset locale cannot shift the label
    // back into the previous month.
    const monthLabel = (ym: string) => {
      const [y, m] = ym.split('-').map(Number);
      return new Date(Date.UTC(y, m - 1, 1)).toLocaleDateString(ctx.lang, {
        year: 'numeric',
        month: 'long',
        timeZone: 'UTC',
      });
    };

    const INVOICE_BADGE: Record<string, string> = {
      paid: 'border-ok text-ok',
      open: 'border-warn text-warn',
      void: 'border-danger text-danger',
      uncollectible: 'border-danger text-danger',
    };

    const renderInvoices = (months: InvoiceMonth[]) => {
      invoicesEl.innerHTML = months
        .map(
          (m) => `<div class="card p-0 overflow-x-auto">
            <div class="border-b border-line px-4 py-3 text-sm font-semibold">${esc(monthLabel(m.month))}</div>
            <table class="w-full text-sm">
              <thead class="border-b border-line text-left text-muted">
                <tr>
                  <th class="px-4 py-2">${esc(t('invoices.number'))}</th>
                  <th class="px-4 py-2">${esc(t('credits.date'))}</th>
                  <th class="px-4 py-2">${esc(t('invoices.status'))}</th>
                  <th class="px-4 py-2 text-right">${esc(t('invoices.total'))}</th>
                  <th class="px-4 py-2 text-right">${esc(t('invoices.download'))}</th>
                </tr>
              </thead>
              <tbody>
                ${m.invoices
                  .map(
                    (inv) => `<tr class="border-b border-line last:border-0">
                      <td class="px-4 py-3 font-medium">${esc(inv.number ?? '—')}</td>
                      <td class="px-4 py-3 text-muted">${esc(fmt(inv.issued_at))}</td>
                      <td class="px-4 py-3">
                        <span class="badge ${INVOICE_BADGE[inv.status] ?? ''}">${esc(t(`invoices.st.${inv.status}`))}</span>
                      </td>
                      <td class="px-4 py-3 text-right">${esc(fmtMoney(inv.total_cents, inv.currency))}</td>
                      <td class="px-4 py-3 text-right">
                        <button class="inv-dl btn-ghost text-xs" data-id="${esc(inv.id)}">${esc(t('invoices.pdf'))}</button>
                      </td>
                    </tr>`,
                  )
                  .join('')}
              </tbody>
            </table>
          </div>`,
        )
        .join('');

      // The URL is resolved on demand, never rendered into the DOM: the issuer's
      // links expire, so a href baked at render time would rot on the page.
      for (const btn of invoicesEl.querySelectorAll<HTMLButtonElement>('.inv-dl')) {
        btn.addEventListener('click', async () => {
          const label = btn.textContent;
          btn.disabled = true;
          btn.textContent = t('common.loading');
          const r = await getOrgInvoicePdf(orgId, btn.dataset.id!);
          btn.disabled = false;
          btn.textContent = label;
          if (r.data?.url) window.open(r.data.url, '_blank', 'noopener');
          else alert(t('invoices.downloadError'));
        });
      }
    };

    {
      const r = await getOrgInvoices(orgId);
      loadingEl.classList.add('hidden');
      if (!r.ok || !r.data) {
        errorEl.classList.remove('hidden');
      } else if (r.data.months.length === 0) {
        emptyEl.classList.remove('hidden');
      } else {
        renderInvoices(r.data.months);
      }
    }

    document.getElementById('buy')!.addEventListener('click', async () => {
      const raw = prompt(t('credits.buyAmount'), '1000');
      const amount = raw ? parseInt(raw, 10) : NaN;
      if (!amount || amount <= 0) return;
      const r = await purchaseCredits(orgId, amount);
      go(r.data?.url);
    });
    document.getElementById('manage')!.addEventListener('click', async () => {
      const r = await billingPortal(orgId);
      go(r.data?.url);
    });
  });
</script>
