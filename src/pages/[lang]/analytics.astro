---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localePaths, isLocale, DEFAULT_LOCALE, useTranslations } from '../../lib/i18n';

export function getStaticPaths() {
  return localePaths();
}

const lang = isLocale(Astro.params.lang) ? Astro.params.lang : DEFAULT_LOCALE;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('analytics.title')} chrome>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold">{t('analytics.title')}</h1>
    <label class="flex items-center gap-2 text-sm text-muted">
      {t('analytics.range')}
      <select id="range" class="field max-w-44 text-sm">
        <option value="7">{t('analytics.range7')}</option>
        <option value="30" selected>{t('analytics.range30')}</option>
        <option value="90">{t('analytics.range90')}</option>
      </select>
    </label>
  </div>

  <p id="msg" class="mt-6 text-muted">{t('common.loading')}</p>

  <div id="content" class="mt-6 hidden">
    <!-- KPI cards -->
    <div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-5">
      <div class="card">
        <div class="text-xs text-muted">{t('analytics.kpiCalls')}</div>
        <div id="kpi-calls" class="mt-1 text-2xl font-bold">—</div>
      </div>
      <div class="card">
        <div class="text-xs text-muted">{t('analytics.kpiMinutes')}</div>
        <div id="kpi-minutes" class="mt-1 text-2xl font-bold">—</div>
      </div>
      <div class="card">
        <div class="text-xs text-muted">{t('analytics.kpiTranscripts')}</div>
        <div id="kpi-transcripts" class="mt-1 text-2xl font-bold">—</div>
      </div>
      <div class="card">
        <div class="text-xs text-muted">{t('analytics.kpiRecordings')}</div>
        <div id="kpi-recordings" class="mt-1 text-2xl font-bold">—</div>
      </div>
      <div class="card">
        <div class="text-xs text-muted">{t('analytics.kpiCredits')}</div>
        <div id="kpi-credits" class="mt-1 text-2xl font-bold">—</div>
      </div>
    </div>

    <div class="mt-4 grid gap-4 lg:grid-cols-2">
      <div class="card">
        <div class="text-sm font-semibold">{t('analytics.callsOverTime')}</div>
        <div id="chart-calls" class="mt-3"></div>
      </div>
      <div class="card">
        <div class="text-sm font-semibold">{t('analytics.spendByType')}</div>
        <div id="chart-spend" class="mt-3"></div>
      </div>
    </div>

    <div class="card mt-4">
      <div class="text-sm font-semibold">{t('analytics.topProjects')}</div>
      <div id="top-projects" class="mt-3"></div>
    </div>
  </div>
</BaseLayout>

<script>
  import { boot } from '../../scripts/app-boot';
  import { getAnalytics, type AnalyticsSummary } from '../../lib/api';
  import { useTranslations, type Locale } from '../../lib/i18n';

  function esc(s: string): string {
    return s.replace(
      /[&<>"]/g,
      (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] || c,
    );
  }

  // A categorical palette for the credits-by-type bars (reuses the theme tokens).
  const PALETTE = [
    'var(--color-brand)',
    'var(--color-ok)',
    'var(--color-warn)',
    'var(--color-danger)',
    'var(--color-muted)',
  ];

  /** Vertical bar chart of a daily series, as inline SVG (no chart dependency). */
  function barChart(points: { day: string; calls: number; minutes: number }[], unit: string): string {
    if (points.length === 0) return '';
    const W = 560;
    const H = 180;
    const pad = { l: 28, r: 8, t: 8, b: 22 };
    const iw = W - pad.l - pad.r;
    const ih = H - pad.t - pad.b;
    const max = Math.max(1, ...points.map((p) => p.calls));
    const n = points.length;
    const gap = 2;
    const bw = Math.max(1, iw / n - gap);
    const bars = points
      .map((p, i) => {
        const h = (p.calls / max) * ih;
        const x = pad.l + i * (iw / n);
        const y = pad.t + (ih - h);
        return `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${bw.toFixed(1)}" height="${h.toFixed(1)}" rx="1.5" fill="var(--color-brand)"><title>${esc(p.day)}: ${p.calls} ${esc(unit)} · ${p.minutes} min</title></rect>`;
      })
      .join('');
    // y-axis max + 0 labels, x-axis first/last day.
    const labels = `
      <text x="0" y="${pad.t + 8}" font-size="10" fill="var(--color-muted)">${max}</text>
      <text x="0" y="${pad.t + ih}" font-size="10" fill="var(--color-muted)">0</text>
      <text x="${pad.l}" y="${H - 6}" font-size="9" fill="var(--color-muted)">${esc(points[0].day.slice(5))}</text>
      <text x="${W - pad.r}" y="${H - 6}" font-size="9" text-anchor="end" fill="var(--color-muted)">${esc(points[n - 1].day.slice(5))}</text>`;
    return `<svg viewBox="0 0 ${W} ${H}" class="w-full" role="img" preserveAspectRatio="none" style="max-height:200px">${bars}${labels}</svg>`;
  }

  /** Horizontal labelled bars (credits by type). */
  function hbars(items: { label: string; value: number }[], suffix = ''): string {
    if (items.length === 0) return '';
    const max = Math.max(1, ...items.map((i) => i.value));
    return (
      '<div class="flex flex-col gap-2">' +
      items
        .map((it, i) => {
          const pct = (it.value / max) * 100;
          const color = PALETTE[i % PALETTE.length];
          return `<div class="flex items-center gap-2 text-sm">
            <span class="w-28 shrink-0 truncate text-muted" title="${esc(it.label)}">${esc(it.label)}</span>
            <span class="h-3 rounded" style="width:${pct.toFixed(1)}%;min-width:2px;background:${color}"></span>
            <span class="ml-auto tabular-nums">${it.value}${esc(suffix)}</span>
          </div>`;
        })
        .join('') +
      '</div>'
    );
  }

  void (async () => {
    const ctx = await boot();
    if (!ctx) return;
    const t = useTranslations(ctx.lang as Locale);
    const orgId = ctx.activeOrg.id;
    const msg = document.getElementById('msg')!;
    const content = document.getElementById('content')!;

    // Spend is financial → admins/owners only (matches the API gate).
    if (ctx.activeOrg.role !== 'admin' && ctx.activeOrg.role !== 'owner') {
      msg.textContent = t('analytics.adminOnly');
      return;
    }

    const render = (a: AnalyticsSummary) => {
      const set = (id: string, v: number) =>
        (document.getElementById(id)!.textContent = String(v));
      set('kpi-calls', a.kpis.calls);
      set('kpi-minutes', a.kpis.minutes);
      set('kpi-transcripts', a.kpis.transcripts);
      set('kpi-recordings', a.kpis.recordings);
      set('kpi-credits', a.kpis.credits_spent);

      document.getElementById('chart-calls')!.innerHTML =
        barChart(a.calls_by_day, t('analytics.calls')) ||
        `<p class="text-sm text-muted">${esc(t('analytics.noData'))}</p>`;

      document.getElementById('chart-spend')!.innerHTML =
        hbars(a.credits_by_type.map((x) => ({ label: x.type, value: x.spent }))) ||
        `<p class="text-sm text-muted">${esc(t('analytics.noData'))}</p>`;

      const tp = a.top_projects;
      document.getElementById('top-projects')!.innerHTML = tp.length
        ? hbars(tp.map((p) => ({ label: p.name, value: p.calls })), ` ${t('analytics.calls')}`)
        : `<p class="text-sm text-muted">${esc(t('analytics.noData'))}</p>`;
    };

    const load = async (days: number) => {
      msg.textContent = t('common.loading');
      msg.classList.remove('hidden');
      content.classList.add('hidden');
      const r = await getAnalytics(orgId, days);
      if (!r.ok || !r.data) {
        msg.textContent = t('common.error');
        return;
      }
      render(r.data);
      msg.classList.add('hidden');
      content.classList.remove('hidden');
    };

    const range = document.getElementById('range') as HTMLSelectElement;
    range.addEventListener('change', () => void load(parseInt(range.value, 10) || 30));
    await load(30);
  })();
</script>
